@model CompletedSubject
@{
    var returnUrl = ViewData["ReturnUrl"] as string;
    var subjectName = ViewData["SubjectName"] as string;
    var groupName = ViewData["GroupName"] as string;
}

<div class="container mt-4">
    <div class="card">
        <div class="card-header bg-danger text-white">
            <h5>Продолжение предмета</h5>
        </div>
        <div class="card-body">
            <div class="alert alert-warning">
                <p><strong>Группа:</strong> @groupName</p>
                <p><strong>Предмет:</strong> @subjectName</p>
                <hr />
                <p>Вы уверены, что хотите продолжить этот предмет?</p>
            </div>
            
            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="SubjectID" value="@Model.SubjectID" />
                <input type="hidden" name="GroupID" value="@Model.GroupID" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                
                <div class="text-center">
                    <button type="submit" class="btn btn-danger">Подтвердить</button>
                    @if (!string.IsNullOrEmpty(returnUrl))
                    {
                        <a href="@returnUrl" class="btn btn-secondary">Отмена</a>
                    }
                    else
                    {
                        <a asp-controller="Journals" asp-action="AdjustedJournal" 
                           asp-route-GroupID="@Model.GroupID" asp-route-SubjectID="@Model.SubjectID" 
                           class="btn btn-secondary">Отмена</a>
                    }
                </div>
            </form>
        </div>
    </div>
</div>