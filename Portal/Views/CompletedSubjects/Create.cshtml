@model Portal.Models.CompletedSubject

@{
    ViewData["Title"] = "Добавить пройденный предмет";
}

@await Html.PartialAsync("_NavMenuJournal")

<div class="container mt-3">
    <h4>@ViewData["Title"]</h4>
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-group">
            <label for="SubjectID">Дисциплина</label>
            <select class="form-control" asp-for="SubjectID" asp-items="@(ViewData["SubjectID"] as SelectList)"></select>
        </div>
        <div class="form-group">
            <label for="GroupID">Группа</label>
            <select class="form-control" asp-for="GroupID" asp-items="@(ViewData["GroupID"] as SelectList)"></select>
        </div>
        <div class="form-group mt-2">
            <input type="submit" value="Добавить" class="btn btn-primary" />
            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Назад</a>
        </div>
    </form>
</div>
