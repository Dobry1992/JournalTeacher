@model CompletedSubject
@{
    var returnUrl = ViewData["ReturnUrl"] as string;
    var subjectName = ViewData["SubjectName"] as string;
    var groupName = ViewData["GroupName"] as string;
}

<div class="container mt-4">
    <div class="card">
        <div class="card-header bg-warning">
            <h5>Завершение предмета</h5>
        </div>
        <div class="card-body">
            <div class="alert alert-info">
                <p><strong>Группа:</strong> @groupName</p>
                <p><strong>Предмет:</strong> @subjectName</p>
            </div>
            
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="SubjectID" />
                <input type="hidden" asp-for="GroupID" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                
                <div class="text-center">
                    <button type="submit" class="btn btn-success">Подтвердить завершение</button>
                    @if (!string.IsNullOrEmpty(returnUrl))
                    {
                        <a href="@returnUrl" class="btn btn-secondary">Отмена</a>
                    }
                    else
                    {
                        <a asp-controller="Journals" asp-action="AdjustedJournal" 
                           asp-route-GroupID="@Model.GroupID" asp-route-SubjectID="@Model.SubjectID" 
                           class="btn btn-secondary">Отмена</a>
                    }
                </div>
            </form>
        </div>
    </div>
</div>