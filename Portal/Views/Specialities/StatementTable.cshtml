@model List<CourseGroup>

@{
    ViewData["Title"] = "Сводная ведомость";
    int n = 1;
}

@await Html.PartialAsync("_NavMenuJournal")

<div>
    <section class="content-header">
        <div class="container-fluid">
            <div class="row">
            </div>
        </div>
    </section>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info mb-0">Нет данных для отображения.</div>
}
else
{
    <div class="container-fluid mt-3">
        <div class="card">
            <div class="card-body">
                <h6 class="mb-3 text-center bg-gray-light headGroup p-2 rounded shadow">
                    Сводная ведомость<br />
                    @ViewBag.Speciality.Name<br />
                    @ViewBag.Year
                </h6>
                <div class="table-responsive" id="sd">
                    <table class="table table-bordered table-sm compact" id="marks">
                        <thead class="thead-dark">
                            <tr role="row">
                                <th class="text-center align-middle p-1 fix tableRowSticky title-row">#</th>
                                <th class="text-center align-middle p-1 fix tableRowSticky title-row">Ф.И.О.</th>
                                @foreach (var d in ViewBag.Disciplines)
                                {
                                    <th class="text-center align-middle p-0 tableRowSticky">
                                        <span class="btn btn-outline-danger border-0 p-1 text-white btn-tooltip"
                                              data-toggle="tooltip"
                                              data-html="true"
                                              title="@d.Name">
                                            <span class="rotate-sm-90">
                                                @d.ShortName
                                            </span>
                                        </span>
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody class="bg-white compact">
                            @foreach (var group in Model)
                            {
                                <tr>
                                    <td class="text-center align-middle bg-light p-1 fix">@n</td>
                                    <td class="text-center align-middle bg-light p-1 fix" style="white-space:nowrap">@group.Group.Name</td>
                                    @foreach (var d in group.CourseDisciplines)
                                    {
                                        <td class="text-center align-middle p-1 btn-tooltip">
                                            <span class="text-center align-middle btn-tooltip">
                                                @d.Mark
                                            </span>
                                        </td>
                                    }
                                </tr>
                                n++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(function () {
            $('.btn-tooltip').tooltip();
        });
        document.addEventListener("DOMContentLoaded", function () {
            const div = document.getElementById('sd');
            const savedScroll = localStorage.getItem('scrollLeft') || 0;
            const savedScrollTop = localStorage.getItem('scrollTop') || 0;

            div.scrollLeft = savedScroll;
            div.scrollTop = savedScrollTop;

            div.addEventListener('scroll', () => {
                localStorage.setItem('scrollLeft', div.scrollLeft);
                localStorage.setItem('scrollTop', div.scrollTop);
            });
        });
    </script>
}