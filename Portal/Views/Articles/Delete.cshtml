@model Portal.Models.Article

@{
    ViewData["Title"] = "Удаление новости";
}

<nav class="main-header navbar navbar-expand navbar-white navbar-light">
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
        </li>
        @if (User.IsInRole("SuperAdmin") || User.IsInRole("Journalist"))
        {
            <li class="nav-item d-none d-sm-inline-block">
                <a asp-controller="Articles" asp-action="Create" class="nav-link text-info">Добавить новость</a>
            </li>
        }
    </ul>
    <ul class="navbar-nav ml-auto">
        <li class="nav-item">
            <a asp-controller="Home" asp-action="Index" class="nav-link text-right">@ViewBag.FullName</a>
        </li>
    </ul>
</nav>

<div>
    <section class="content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                </div>
            </div>
        </div>
    </section>
    <section class="content mt-3">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <div id="example1_wrapper" class="dataTables_wrapper dt-bootstrap4">
                                <div class="row">
                                    <div class="col-sm-12">
                                        <div class="bg-danger text-center text-white">
                                            <h4>Вы уверены что желаете удалить?</h4>
                                            <p>Удаление новости повлечет за собой удаление всех связанных с ней данных.</p>
                                        </div>
                                        <dl class="row">
                                            <dt class="col-sm-2">
                                                Заголовок
                                            </dt>
                                            <dd class="col-sm-10">
                                                @Html.DisplayFor(model => model.Title)
                                            </dd>
                                            <dt class="col-sm-2">
                                                Дата
                                            </dt>
                                            <dd class="col-sm-10">
                                                @Html.DisplayFor(model => model.DateOfNews)
                                            </dd>
                                        </dl>
                                        <form asp-action="Delete">
                                            <input type="hidden" asp-for="ArticleID" />
                                            <input type="submit" value="Удалить" class="btn btn-danger" />
                                            <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Назад</a>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>