@model IEnumerable<Portal.Models.Teacher>

@{
    ViewData["Title"] = "Преподаватели";
}

@await Html.PartialAsync("_NavMenuJournal")

<div>
    <section class="content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-1">Преподаватели</h3>
                </div>
            </div>
        </div>
    </section>
    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <div id="example1_wrapper" class="dataTables_wrapper dt-bootstrap4">
                                <div class="row">
                                    <div class="col-sm-12 table-wrap">
                                        <a asp-action="Create" class="btn btn-primary mb-3">Добавить преподавателя</a>
                                        <table id="Table" class="table compact table-sm dataTable dtr-inline" role="grid">
                                            <thead class="thead-light">
                                                <tr role="row">
                                                    <th class="sorting">Ф.И.О.</th>
                                                    <th class="sorting fix">Действие</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in Model)
                                                {
                                                    <tr role="row" class="odd">
                                                        <td tabindex="0" class="sorting_1">@item.FamilyName @item.Name @item.Surname</td>
                                                        <td tabindex="0" class="sorting_1 fix">
                                                            <div class="container">
                                                                <a title="Редактировать" class="btn btn-warning btn-sm" asp-controller="Teachers" asp-action="Edit" asp-route-id="@item.TeacherID"><i class="fa fa-file-edit"></i></a>
                                                                <a title="Удалить" class="btn btn-danger btn-sm" asp-controller="Teachers" asp-action="Delete" asp-route-id="@item.TeacherID"><i class="fa fa-remove"></i></a>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@section scripts{
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}