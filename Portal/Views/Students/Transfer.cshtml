@model Portal.ViewModel.TransferStudentViewModel

@{
    ViewData["Title"] = "Перевод";
}

@await Html.PartialAsync("_NavMenuJournal")

<div style="padding:5%">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                </div>
            </div>
        </div>
    </section>
    <section class="content mt-3">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <div id="example1_wrapper" class="dataTables_wrapper dt-bootstrap4">
                                <div class="row">
                                    <div class="col-sm-12">
                                        <div class="bg-warning text-dark text-center">
                                            <h4>Перевод слушателя/курсанта в другую группу</h4>
                                            <p>Пройденные занятия и отметки будут сохранены в истории перевода и удалены из журнала старой группы. В новой группе будут созданы отметки «-» по всем пройденным занятиям.</p>
                                        </div>
                                        <dl class="row">
                                            <dd class="col-sm-10">
                                                <h4>Слушатель/курсант</h4>
                                            </dd>
                                            <dd class="col-sm-10" data-student-id="@Model.StudentID">
                                                Фамилия: @Model.LastName
                                            </dd>
                                            <dd class="col-sm-10">
                                                Имя: @Model.Name
                                            </dd>
                                            <dd class="col-sm-10">
                                                Отчество: @Model.Surname
                                            </dd>
                                            <dd class="col-sm-10">
                                                Текущая группа: @Model.OldGroupName
                                            </dd>
                                        </dl>
                                        <form asp-action="Transfer" method="post">
                                            <input type="hidden" asp-for="StudentID" />
                                            <input type="hidden" asp-for="OldGroupID" />
                                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                                            <div class="form-group">
                                                <label asp-for="NewGroupID" class="control-label"></label>
                                                <select asp-for="NewGroupID" class="form-control" asp-items="Model.Groups">
                                                    <option value="0">Группа не выбрана</option>
                                                </select>
                                                <span asp-validation-for="NewGroupID" class="text-danger"></span>
                                            </div>
                                            <div class="form-group">
                                                <label asp-for="Comment" class="control-label"></label>
                                                <textarea asp-for="Comment" class="form-control" rows="3" placeholder="Основание перевода (приказ, рапорт и т.д.)"></textarea>
                                                <span asp-validation-for="Comment" class="text-danger"></span>
                                            </div>
                                            <div class="form-group">
                                                <input type="submit" value="Перевести" class="btn btn-warning" />
                                                <a class="btn btn-primary" asp-controller="Students" asp-action="Details" asp-route-id="@Model.StudentID">Назад</a>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
