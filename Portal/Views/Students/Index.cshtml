@model IEnumerable<Portal.Models.Student>

@{
    ViewBag.Title = "Слушатели/студенты";
    int i = 1;
}

@await Html.PartialAsync("_NavMenuJournal")

<div>
    <section class="content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-1">Слушатели/курсанты</h3>
                </div>
            </div>
        </div>
    </section>
    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <div id="example1_wrapper" class="dataTables_wrapper dt-bootstrap4">
                                <div class="row">
                                    <div class="col-sm-12 table-wrap">
                                        <a asp-action="Create" class="btn btn-primary mb-3">Добавить слушателя/курсанта</a>
                                        <table id="Table" class="table table-bordered compact table-sm dataTable dtr-inline" role="grid">
                                            <thead class="thead-dark">
                                                <tr role="row">
                                                    <th class="sorting_asc">#</th>
                                                    <th class="sorting_asc">Ф.И.О.</th>
                                                    <th class="sorting">Дата рождения</th>
                                                    <th class="sorting">Регион подбора</th>
                                                    <th class="sorting">Группа</th>
                                                    <th class="sorting fix">Действие</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in Model)
                                                {
                                                    @if (item.Status == true)
                                                    {
                                                        <tr role="row" class="odd bg-white">
                                                            <td tabindex="0" class="sorting_1">@i</td>
                                                            <td tabindex="0" class="sorting_1">@item.LastName @item.Name @item.Surname</td>
                                                            <td tabindex="0" class="sorting_1">@item.DateOfBirth.ToShortDateString()</td>
                                                            <td tabindex="0" class="sorting_1">@Html.DisplayFor(modelItem => item.PlaceOfBirth)</td>
                                                            <td tabindex="0" class="sorting_1">@Html.DisplayFor(modelItem => item.Group.Name)</td>
                                                            <td tabindex="0" class="sorting_1 fix">
                                                                <div class="container">
                                                                    <a title="Редактировать" class="btn btn-warning btn-sm" asp-controller="Students" asp-action="Edit" asp-route-id="@item.StudentID"><i class="fa fa-edit"></i></a>
                                                                    <a title="Информация" class="btn btn-info btn-sm" asp-controller="Students" asp-action="Details" asp-route-id="@item.StudentID"><i class="fa fa-info"></i></a>
                                                                    <a title="Отчислить" class="btn btn-secondary btn-sm" asp-controller="Students" asp-action="SetStatus" asp-route-id="@item.StudentID"><i class="fa fa-lock"></i></a>
                                                                    <a title="Удалить" class="btn btn-danger btn-sm" asp-controller="Students" asp-action="Delete" asp-route-id="@item.StudentID"><i class="fa fa-remove"></i></a>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }
                                                    else
                                                    {
                                                        <tr role="row" class="odd bg-gray">
                                                            <td tabindex="0" class="sorting_1">@i</td>
                                                            <td tabindex="0" class="sorting_1">@item.LastName @item.Name @item.Surname</td>
                                                            <td tabindex="0" class="sorting_1">@item.DateOfBirth.ToShortDateString()</td>
                                                            <td tabindex="0" class="sorting_1">@Html.DisplayFor(modelItem => item.PlaceOfBirth)</td>
                                                            <td tabindex="0" class="sorting_1">@Html.DisplayFor(modelItem => item.Group.Name)</td>
                                                            <td tabindex="0" class="sorting_1 fix">
                                                                <div class="container">
                                                                    <a title="Редактировать" class="btn btn-warning btn-sm" asp-controller="Students" asp-action="Edit" asp-route-id="@item.StudentID"><i class="fa fa-edit"></i></a>
                                                                    <a title="Информация" class="btn btn-info btn-sm" asp-controller="Students" asp-action="Details" asp-route-id="@item.StudentID"><i class="fa fa-info"></i></a>
                                                                    <a title="Восстановить" class="btn btn-success btn-sm" asp-controller="Students" asp-action="SetStatus" asp-route-id="@item.StudentID"><i class="fa fa-lock-open"></i></a>
                                                                    <a title="Удалить" class="btn btn-danger btn-sm" asp-controller="Students" asp-action="Delete" asp-route-id="@item.StudentID"><i class="fa fa-remove"></i></a>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }
                                                    i++;
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@section scripts{
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
