@model Portal.Models.Student

@{
    ViewData["Title"] = "Редактировать слушателя/курсанта";
}

@await Html.PartialAsync("_NavMenuJournal")

<div style="padding:5%">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3>Редактировать слушателя/курсанта</h3>
                </div>
            </div>
        </div>
    </section>
    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <div id="example1_wrapper" class="dataTables_wrapper dt-bootstrap4">
                                <div class="row">
                                    <div class="col-sm-12">
                                        <form asp-action="Edit">
                                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                                            <input type="hidden" asp-for="StudentID" />
                                            <input type="hidden" asp-for="Status" />
                                            <input type="hidden" asp-for="InstituteID" />
                                            <div class="form-group">
                                                <label asp-for="GroupID" class="control-label">Группа</label>
                                                <select asp-for="GroupID" class="form-control" asp-items="ViewBag.GroupID"></select>
                                                <span asp-validation-for="GroupID" class="text-danger"></span>
                                            </div>
                                            <div class="form-group">
                                                <label asp-for="Name" class="control-label">Имя</label>
                                                <input asp-for="Name" class="form-control" />
                                                <span asp-validation-for="Name" class="text-danger"></span>
                                            </div>
                                            <div class="form-group">
                                                <label asp-for="Surname" class="control-label">Отчество</label>
                                                <input asp-for="Surname" class="form-control" />
                                                <span asp-validation-for="Surname" class="text-danger"></span>
                                            </div>
                                            <div class="form-group">
                                                <label asp-for="LastName" class="control-label">Фамилия</label>
                                                <input asp-for="LastName" class="form-control" />
                                                <span asp-validation-for="LastName" class="text-danger"></span>
                                            </div>
                                            <div class="form-group">
                                                <label asp-for="PlaceOfBirth" class="control-label">Регион подбора</label>
                                                <input asp-for="PlaceOfBirth" class="form-control" />
                                                <span asp-validation-for="PlaceOfBirth" class="text-danger"></span>
                                            </div>
                                            <div class="form-group">
                                                <label asp-for="DateOfBirth" class="control-label">Дата рождения</label>
                                                <input type="date" asp-for="DateOfBirth" class="form-control" />
                                                <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                                            </div>
                                            <div class="form-group">
                                                <input type="submit" value="Сохранить" class="btn btn-success" />
                                                <a class="btn btn-primary" asp-action="Index">Назад</a>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
