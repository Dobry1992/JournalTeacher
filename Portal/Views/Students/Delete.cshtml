@model Portal.Models.Student

@{
    ViewData["Title"] = "Delete";
}

@await Html.PartialAsync("_NavMenuJournal")

<div style="padding:10%">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                </div>
            </div>
        </div>
    </section>
    <section class="content mt-3">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <div id="example1_wrapper" class="dataTables_wrapper dt-bootstrap4">
                                <div class="row">
                                    <div class="col-sm-12">
                                        <div class="bg-danger text-white text-center">
                                            <h4>Вы уверены что желаете удалить?</h4>
                                            <p>Удаление слушателя/курсанта повлечет за собой удаление всех связанных с ним данных.</p>
                                        </div>
                                        <dl class="row">
                                            <dd class="col-sm-10">
                                                <h4>Слушатель/курсант</h4>
                                            </dd>
                                            <dd class="col-sm-10">
                                                Фамилия: @Html.DisplayFor(model => model.LastName)
                                            </dd>
                                            <dd class="col-sm-10">
                                                Имя: @Html.DisplayFor(model => model.Name)
                                            </dd>
                                            <dd class="col-sm-10">
                                                Отчество: @Html.DisplayFor(model => model.Surname)
                                            </dd>
                                        </dl>
                                        <form asp-action="Delete">
                                            <input type="hidden" asp-for="StudentID" />
                                            <input type="submit" value="Удалить" class="btn btn-danger" />
                                            <a class="btn btn-primary" asp-controller="Students" asp-action="Index">Назад</a>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

