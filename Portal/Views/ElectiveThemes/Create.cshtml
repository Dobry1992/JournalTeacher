@model Portal.Models.Elective.ElectiveTheme

@{
    ViewData["Title"] = "Добавить тему факультатива";
}

@await Html.PartialAsync("_NavMenuJournal")

<div style="padding:3%">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3>Создать тему факультативного занятия</h3>
                </div>
            </div>
        </div>
    </section>
    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <div id="example1_wrapper" class="dataTables_wrapper dt-bootstrap4">
                                <div class="row">
                                    <div class="col-sm-12">
                                        <form asp-action="Create">
                                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                                            <div class="form-group">
                                                <label asp-for="Name" class="control-label">Наименование</label>
                                                <input asp-for="Name" class="form-control" />
                                                <span asp-validation-for="Name" class="text-danger"></span>
                                            </div>
                                            <div class="form-group">
                                                <label asp-for="ShortName" class="control-label">Краткое наименование (цифровое)</label>
                                                <input asp-for="ShortName" class="form-control" />
                                                <span asp-validation-for="ShortName" class="text-danger"></span>
                                            </div>
                                            <div class="form-group">
                                                <label asp-for="ElectiveID" class="control-label">Факультатив</label>
                                                <select asp-for="ElectiveID" class="form-control" asp-items="ViewBag.ElectiveID"></select>
                                            </div>
                                            <div class="form-group">
                                                <input type="submit" value="Добавить" class="btn btn-success" />
                                                <a class="btn btn-primary" asp-controller="Electives" asp-action="Details" asp-route-id="@ViewBag.Id">Назад</a>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
