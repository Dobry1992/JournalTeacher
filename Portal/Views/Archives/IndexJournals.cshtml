@model IEnumerable<Portal.Models.JournalArhive>

@{
    ViewData["Title"] = "Журналы отметок";
    int i = 1;
}

@await Html.PartialAsync("_NavMenuJournal")

<div style="padding:7%">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h2>Список журналов</h2>
                </div>
            </div>
        </div>
    </section>
    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <h6 class="text-center">Введите даты поиска</h6>
                            <form asp-action="IndexJournals" method="get" class="form-inline mb-3">
                                <div class="form-group m-auto">
                                    <label class="mr-2" for="date_1">с</label>
                                    <input class="form-control form-control-sm mr-2" type="date" name="date_1" />
                                    <label class="mr-2" for="date_2">по</label>
                                    <input class="form-control form-control-sm mr-2" type="date" name="date_2">
                                    <input type="submit" value="Поиск" class="btn btn-primary btn-sm mr-2" />
                                </div>
                            </form>
                            <div id="example1_wrapper" class="dataTables_wrapper dt-bootstrap4">
                                <div class="row">
                                    <div class="col-sm-12">
                                        <table class="table compact dataTable table-sm" role="grid" id="ArchiveTable">
                                            <thead class="thead-light">
                                                <tr role="row">
                                                    <th class="sorting_asc">#</th>
                                                    <th class="sorting">Группа</th>
                                                    <th class="sorting">Предмет</th>
                                                    <th class="sorting">Дата создания</th>
                                                    <th class="sorting"></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in Model)
                                                {
                                                    <tr role="row" class="odd bg-white">
                                                        <td tabindex="0" class="sorting_1">@i</td>
                                                        <td tabindex="0" class="sorting_1">@item.GroupArhive.Name</td>
                                                        <td tabindex="0" class="sorting_1">@item.Subject.Name</td>
                                                        <td tabindex="0" class="sorting_1">@item.Date.ToShortDateString()</td>
                                                        <td tabindex="0" class="sorting_1 text-center"><a class="btn btn-success btn-sm" asp-route-GroupID ="@item.GroupArhiveID" asp-route-SubjectID="@item.SubjectID" asp-controller="Archives" asp-action="ArchiveJournal">Перейти</a></td>
                                                    </tr>
                                                    i++;
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<script src="~/js/archiveJournal.js"></script>