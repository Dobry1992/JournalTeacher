@model IEnumerable<Portal.Models.StudentArhive>

@{
    ViewData["Title"] = "Институты";
    int i = 1;
}

@await Html.PartialAsync("_NavMenuJournal")

<div style="padding:7%">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                </div>
            </div>
        </div>
    </section>
    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <h3 class="text-center bg-blue shadow p-3 mb-3 rounded">Слушатели/курсанты</h3>
                            <form asp-action="IndexStudents" method="get" class="form-inline mb-3">
                                <div class="form-group m-auto">
                                    <div class="input-group-append">
                                        <input class="form-control mr-2" type="text" name="searchString" placeholder="Фамилия..." />
                                        <button class="btn btn-success" type="submit"><i class="fas fa-search"></i></button>
                                    </div>
                                </div>
                            </form>
                            <div id="example1_wrapper" class="dataTables_wrapper dt-bootstrap4">
                                <div class="row">
                                    <div class="col-sm-12">
                                        <table class="table table-bordered compact dataTable hover" role="grid" id="studentsTable">
                                            <thead class="thead-dark">
                                                <tr role="row">
                                                    <th class="sorting_asc text-center">#</th>
                                                    <th class="sorting_asc text-center">Ф.И.О.</th>
                                                    <th class="sorting_asc text-center">Группа</th>
                                                    <th class="sorting_asc text-center">Институт</th>
                                                    <th class="sorting_asc text-center"></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in Model)
                                                {
                                                    <tr role="row" class="odd bg-white text-center">
                                                        <td tabindex="0" class="sorting_1">@i</td>
                                                        <td tabindex="0" class="sorting_1">@item.LastName @item.Name[0]. @item.Surname[0].</td>
                                                        <td tabindex="0" class="sorting_1">@item.GroupArhive.Name</td>
                                                        <td tabindex="0" class="sorting_1">@item.GroupArhive.Speciality.Institute.Name</td>
                                                        <td tabindex="0" class="sorting_1"><a class="btn btn-success" asp-controller="Archives" asp-action="ArchiveStudent" asp-route-id="@item.StudentArhiveID"><i class="fas fa-arrow-right"></i></a></td>
                                                    </tr>
                                                    i++;
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<script src="~/js/students.js"></script>