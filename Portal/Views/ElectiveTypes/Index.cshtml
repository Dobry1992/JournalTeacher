@model IEnumerable<Portal.Models.Elective.ElectiveType>

@{
    ViewData["Title"] = "Типы факультативных занятий";
    int i = 1;
}

@await Html.PartialAsync("_NavMenuJournal")

<div>
    <section class="content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-1">Типы факультативных занятий</h3>
                </div>
            </div>
        </div>
    </section>
    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <div id="example1_wrapper" class="dataTables_wrapper dt-bootstrap4">
                                <div class="row">
                                    <div class="col-sm-12 table-wrap">
                                        <a asp-action="Create" class="btn btn-primary mb-3 mr-2">Добавить тип факультативного знанятия</a>
                                        <table id="Table" class="table table-bordered dataTable dtr-inline table-sm compact" role="grid">
                                            <thead class="thead-dark">
                                                <tr role="row">
                                                    <th class="sorting_asc">#</th>
                                                    <th class="sorting">Тип факультативного занятия</th>
                                                    <th class="sorting fix">Действие</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in Model)
                                                {
                                                    <tr role="row" class="odd bg-white">
                                                        <td tabindex="0" class="sorting_1">@i</td>
                                                        <td tabindex="0" class="sorting_1">@Html.DisplayFor(modelItem => item.Name)</td>
                                                        <td tabindex="0" class="sorting_1 fix">
                                                            <div class="container">
                                                                <a title="Редактировать" class="btn btn-warning btn-sm" asp-controller="ElectiveTypes" asp-action="Edit" asp-route-id="@item.ElectiveTypeID"><i class="fa fa-file-edit"></i></a>
                                                                <a title="Удалить" class="btn btn-danger btn-sm" asp-controller="ElectiveTypes" asp-action="Delete" asp-route-id="@item.ElectiveTypeID"><i class="fa fa-remove"></i></a>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                    i++;
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@section scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}


