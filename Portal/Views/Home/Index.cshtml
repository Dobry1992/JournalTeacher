@model IEnumerable<Portal.Models.Article>

@{
    ViewData["Title"] = "Портал АНБ";
    int i = 1;
}

<nav class="main-header navbar navbar-expand navbar-white navbar-light">
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
        </li>
        @if (User.IsInRole("SuperAdmin") || User.IsInRole("Journalist") || User.IsInRole("ANB-UMCH"))
        {
            <li class="nav-item dropdown">
                <a id="dropdownSubMenu1" href="#" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" class="nav-link dropdown-toggle">Информация</a>
                <ul aria-labelledby="dropdownSubMenu1" class="dropdown-menu border-0 shadow">
                    <li><a class="dropdown-item" asp-controller="Articles" asp-action="Create">Добавить новость</a></li>
                    <li><a class="dropdown-item" asp-controller="Articles" asp-action="Create">Добавить меню в столовой</a></li>
                    <li><a class="dropdown-item" asp-controller="Home" asp-action="Create">Загрузить расписание</a></li>
                    <li><a class="dropdown-item" asp-controller="" asp-action="">Добавить День Рождения</a></li>
                    <li><a class="dropdown-item" asp-controller="" asp-action="">Добавить информацию о Выборах 2025</a></li>
                </ul>
            </li>
        }
        <li class="nav-item d-none d-sm-inline-block">
            <a asp-controller="Home" asp-action="GetSchedule" class="nav-link" target="_blank">Расписание</a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <a asp-controller="Home" asp-action="" class="nav-link text-success" target="_blank">Выборы 2025</a>
        </li>
    </ul>
    <ul class="navbar-nav ml-auto">
        <li class="nav-item">
            <a asp-controller="Home" asp-action="Index" class="nav-link text-right">@ViewBag.FullName</a>
        </li>
    </ul>
</nav>

<div class="content m-0 pt-3">
    <div class="row">
        <div class="col-md-7">
            @foreach (var n in Model)
            {
                <div class="container mb-3">
                    <div class="gallery-container">
                        <div class="container-fluid p-0">
                            @if (n.Title != null)
                            {
                                <h5>@n.Title.ToString()</h5>
                            }
                            <p class="text-gray">@n.DateOfNews.ToLongDateString() @n.DateOfNews.ToShortTimeString()</p>
                            @if (n.Text != null)
                            {
                                <p>@n.Text.ToString()</p>
                            }
                            @if (User.IsInRole("SuperAdmin") || User.IsInRole("Journalist"))
                            {
                                <div class="btn-group mb-2" role="group">
                                    <a asp-controller="Articles" asp-action="Edit" type="button" class="btn btn-warning btn-sm" asp-route-id="@n.ArticleID"><i class="fas fa-edit"></i></a>
                                    <a asp-controller="Articles" asp-action="Delete" type="button" class="btn btn-danger btn-sm" asp-route-id="@n.ArticleID"><i class="fa fa-remove"></i></a>
                                </div>
                            }
                        </div>
                        @foreach (var image in n.Images)
                        {
                            <div class="gallery-item" data-index="@i">
                                <img src="@image.Path.ToString()">
                            </div>
                            i++;
                        }
                    </div>
                </div>
            }
        </div>
        <div class="col-md-5 position-fixed birthday w-auto">
            <h5 class="bg-gradient-secondary p-2">Дни Рождения</h5>
            <div id="carouselExampleIndicators" class="carousel slide mb-4" data-ride="carousel">
                <ol class="carousel-indicators">
                    <li data-target="#carouselExampleIndicators" data-slide-to="0" class="active"></li>
                    <li data-target="#carouselExampleIndicators" data-slide-to="1"></li>
                    <li data-target="#carouselExampleIndicators" data-slide-to="2"></li>
                </ol>
                <div class="carousel-inner">
                    <div class="carousel-item active">
                        <img src="~/images/news/Logo.png" class="d-block w-100">
                    </div>
                    <div class="carousel-item">
                        <img src="~/images/news/map.jpg" class="d-block w-100">
                    </div>
                    <div class="carousel-item">
                        <img src="~/images/news/map.jpg" class="d-block w-100">
                    </div>
                </div>
                <button class="carousel-control-prev border-0" type="button" data-target="#carouselExampleIndicators" data-slide="prev" style="width:5%;">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="sr-only">Предыдущий</span>
                </button>
                <button class="carousel-control-next border-0" type="button" data-target="#carouselExampleIndicators" data-slide="next" style="width:5%;">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="sr-only">Следующий</span>
                </button>
            </div>
            <div class="carousel-inner">
                <h5 class="bg-gradient-secondary p-2">Меню столовой</h5>
                <div class="carousel-item active">
                    <img src="~/images/news/map.jpg" class="d-block w-100">
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
<script src="../../plugins/jquery/jquery.min.js"></script>
<script src="../../plugins/bootstrap/js/bootstrap.bundle.min.js"></script>



