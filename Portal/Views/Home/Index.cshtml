@model IEnumerable<Portal.Models.Article>

@{
    ViewData["Title"] = "Портал АНБ";
    int i = 1;
}

<nav class="main-header navbar navbar-expand navbar-white navbar-light">
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <a asp-controller="Home" asp-action="Index" class="nav-link">@ViewBag.FullName</a>
        </li>
        @if (User.IsInRole("SuperAdmin") || User.IsInRole("Journalist"))
        {
            <li class="nav-item d-none d-sm-inline-block">
                <a asp-controller="Articles" asp-action="Create" class="nav-link text-info">Добавить новость</a>
            </li>
        }
        @if (User.IsInRole("ANB-UMCH") || User.IsInRole("SuperAdmin"))
        {
            <li class="nav-item d-none d-sm-inline-block">
                <a asp-controller="Home" asp-action="Create" class="nav-link text-info">Добавить расписание</a>
            </li>
        }
        <li class="nav-item d-none d-sm-inline-block">
            <a asp-controller="Home" asp-action="GetSchedule" class="nav-link" target="_blank">Расписание</a>
        </li>
    </ul>
</nav>

<div>
    <section class="content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3></h3>
                </div>
            </div>
        </div>
    </section>
    <section class="content">
        @foreach (var n in Model)
        {
            <div class="container mb-3">
                <div class="gallery-container">
                    <div class="container-fluid p-0">
                        @if (n.Title != null)
                        {
                            <h5>@n.Title.ToString()</h5>
                        }
                        <p class="text-gray">@n.DateOfNews.ToLongDateString() @n.DateOfNews.ToShortTimeString()</p>
                        @if (n.Text != null)
                        {
                            <p>@n.Text.ToString()</p>
                        }
                        @if (User.IsInRole("SuperAdmin") || User.IsInRole("Journalist"))
                        {
                            <div class="btn-group mb-2" role="group">
                                <a asp-controller="Articles" asp-action="Edit" type="button" class="btn btn-warning" asp-route-id="@n.ArticleID"><i class="fas fa-edit"></i></a>
                                <a asp-controller="Articles" asp-action="Delete" type="button" class="btn btn-danger" asp-route-id="@n.ArticleID"><i class="fa fa-remove"></i></a>
                            </div>
                        }
                    </div>
                    @foreach (var image in n.Images)
                    {
                        <div class="gallery-item" data-index="@i">
                            <img src="@image.Path.ToString()">
                        </div>
                        i++;
                    }
                </div>
            </div>
        }
    </section>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}



