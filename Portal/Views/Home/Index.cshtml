@model IEnumerable<Portal.Models.Article>

@{
    ViewData["Title"] = "Портал АНБ";
    int i = 1;
}

<nav class="main-header navbar navbar-expand navbar-white navbar-light">
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
        </li>
        @if (User.IsInRole("SuperAdmin") || User.IsInRole("Journalist") || User.IsInRole("ANB-UMCH"))
        {
            <li class="nav-item dropdown">
                <a id="dropdownSubMenu1" href="#" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" class="nav-link dropdown-toggle">Информация</a>
                <ul aria-labelledby="dropdownSubMenu1" class="dropdown-menu border-0 shadow">
                    <li><a class="dropdown-item" asp-controller="Articles" asp-action="Create">Добавить новость</a></li>
                    <li><a class="dropdown-item" asp-controller="Articles" asp-action="Create">Добавить меню</a></li>
                    <li><a class="dropdown-item" asp-controller="Home" asp-action="Create">Загрузить расписание</a></li>
                    <li><a class="dropdown-item" asp-controller="" asp-action="">Добавить День Рождения</a></li>
                    <li><a class="dropdown-item" asp-controller="" asp-action="">Добавить информацию о Выборах</a></li>
                </ul>
            </li>
        }
        <li class="nav-item d-none d-sm-inline-block">
            <a asp-controller="Home" asp-action="GetSchedule" class="nav-link" target="_blank">Расписание</a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <a asp-controller="Home" asp-action="" class="nav-link" target="_blank">Выборы 2025</a>
        </li>
    </ul>
    <div class="right">
        <a asp-controller="Home" asp-action="Index" class="nav-link">@ViewBag.FullName</a>
    </div>
</nav>

<div>
    <section class="content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3></h3>
                </div>
            </div>
        </div>
    </section>
    <section class="content">
        @foreach (var n in Model)
        {
            <div class="container mb-3">
                <div class="gallery-container">
                    <div class="container-fluid p-0">
                        @if (n.Title != null)
                        {
                            <h5>@n.Title.ToString()</h5>
                        }
                        <p class="text-gray">@n.DateOfNews.ToLongDateString() @n.DateOfNews.ToShortTimeString()</p>
                        @if (n.Text != null)
                        {
                            <p>@n.Text.ToString()</p>
                        }
                        @if (User.IsInRole("SuperAdmin") || User.IsInRole("Journalist"))
                        {
                            <div class="btn-group mb-2" role="group">
                                <a asp-controller="Articles" asp-action="Edit" type="button" class="btn btn-warning btn-sm" asp-route-id="@n.ArticleID"><i class="fas fa-edit"></i></a>
                                <a asp-controller="Articles" asp-action="Delete" type="button" class="btn btn-danger btn-sm" asp-route-id="@n.ArticleID"><i class="fa fa-remove"></i></a>
                            </div>
                        }
                    </div>
                    @foreach (var image in n.Images)
                    {
                        <div class="gallery-item" data-index="@i">
                            <img src="@image.Path.ToString()">
                        </div>
                        i++;
                    }
                </div>
            </div>
        }
    </section>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
<script src="../../plugins/jquery/jquery.min.js"></script>
<script src="../../plugins/bootstrap/js/bootstrap.bundle.min.js"></script>



