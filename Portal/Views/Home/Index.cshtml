@model IEnumerable<Portal.Models.Institute>

@{
    ViewData["Title"] = "Учебные группы";
    string[] colors = { "primary", "success", "danger", "info", "warning", "gradient-navy", "gradient-olive", "gradient-lime", "gradient-teal", "gradient-yellow", "indigo" };
    int i = 0;
}

@await Html.PartialAsync("_NavMenuJournal")

<section class="content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
            </div>
        </div>
    </div>
</section>
@foreach (var institute in Model)
{
    if (i == colors.Length) i = 0;
    @if (institute.Arch == false)
    {
        <section class="content">
            <div class="container-fluid">
                <h4 class="mb-3 text-center bg-@colors[i] headGroup p-2 rounded">@Html.DisplayFor(item => institute.Name)</h4>
                @foreach (var speciality in institute.Specialities)
                {
                    <h6 class="mb-3 text-center bg-@colors[i] headGroup p-2 rounded">Специальность: @Html.DisplayFor(item => speciality.Name)</h6>
                    <div class="d-flex flex-row flex-wrap">
                        @foreach (var group in speciality.Groups)
                        {
                            @if (group.DateExit.AddMonths(1) > DateTime.Now)
                            {
                                <a asp-controller="Departments" asp-action="SetSubject" asp-route-GroupID="@group.GroupID" class="groups d-block p-4 mr-3 mb-3 text-decoration-none rounded shadow-lg bg-@colors[i]">
                                    <p class="text-center">
                                        <span class="text-xl">@Html.DisplayFor(modelItem => group.Name)</span><br />
                                        <span>@group.DateEnter.ToShortDateString() - @group.DateExit.ToShortDateString()</span>
                                    </p>
                                </a>
                            }
                        }
                    </div>
                }
            </div>
        </section>
        <hr>
        i++;
    }
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
