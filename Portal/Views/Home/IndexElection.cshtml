@model IEnumerable<Portal.Models.Election.ElectionArticle>

@{
    ViewData["Title"] = "Выборы 2025";
    int i = 1;
}

<nav class="main-header navbar navbar-expand navbar-white navbar-light">
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
        </li>
        @if (User.IsInRole("SuperAdmin") || User.IsInRole("Journalist") || User.IsInRole("ANB-UMCH"))
        {
            <li class="nav-item dropdown">
                <a id="dropdownSubMenu1" href="#" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" class="nav-link dropdown-toggle">Информация</a>
                <ul aria-labelledby="dropdownSubMenu1" class="dropdown-menu border-0 shadow">
                    <li><a class="dropdown-item" asp-controller="Articles" asp-action="Create">Добавить новость</a></li>
                    <li><a class="dropdown-item" asp-controller="Menus" asp-action="Create">Загрузить меню в столовой</a></li>
                    <li><a class="dropdown-item" asp-controller="Home" asp-action="Create">Загрузить расписание</a></li>
                    <li><a class="dropdown-item" asp-controller="Birthdays" asp-action="Index">Дни Рождения</a></li>
                    <li><a class="dropdown-item" asp-controller="Home" asp-action="CreateElectionArticle">Добавить информацию о Выборах 2025</a></li>
                </ul>
            </li>
        }
        <li class="nav-item d-none d-sm-inline-block">
            <a asp-controller="Home" asp-action="GetSchedule" class="nav-link" target="_blank">Расписание</a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <a asp-controller="Home" asp-action="IndexElection" class="nav-link text-danger"><i class="fas fa-fire"></i> ВЫБОРЫ <span class="text-success">2025</span></a>
        </li>
    </ul>
    <ul class="navbar-nav ml-auto">
        <li class="nav-item">
            <a asp-controller="Home" asp-action="Index" class="nav-link text-right">@ViewBag.FullName</a>
        </li>
    </ul>
</nav>

<div class="content m-0 pt-3">
    <div class="row">
        <div class="col-md-12">
            @foreach (var n in Model)
            {
                <div class="container mb-3">
                    <div class="gallery-container">
                        <div class="container-fluid p-0">
                            @if (n.Title != null)
                            {
                                <h5>@n.Title.ToString()</h5>
                            }
                            <p class="text-gray">@n.Date.ToLongDateString() @n.Date.ToShortTimeString()</p>
                            @if (n.Text != null)
                            {
                                <p>@n.Text.ToString()</p>
                            }
                            @if (User.IsInRole("SuperAdmin") || User.IsInRole("Journalist"))
                            {
                                <div class="btn-group mb-2" role="group">
                                    <a asp-controller="Home" asp-action="EditElection" type="button" class="btn btn-warning btn-sm" asp-route-id="@n.ElectionArticleID"><i class="fas fa-edit"></i></a>
                                    <a asp-controller="" asp-action="DeleteElection" type="button" class="btn btn-danger btn-sm" asp-route-id="@n.ElectionArticleID"><i class="fa fa-remove"></i></a>
                                </div>
                            }
                        </div>
                        @foreach (var image in n.Images)
                        {
                            <div class="gallery-item" data-index="@i">
                                <img src="@image.Path.ToString()">
                            </div>
                            i++;
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
<script src="../../plugins/jquery/jquery.min.js"></script>
<script src="../../plugins/bootstrap/js/bootstrap.bundle.min.js"></script>