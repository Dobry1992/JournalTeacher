@model IEnumerable<Portal.Models.Birthday.Birthday>
@{
    ViewData["Title"] = "Дни Рождения";
    int i = 1;
}

<nav class="main-header navbar navbar-expand navbar-white navbar-light">
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
        </li>
        @if (User.IsInRole("SuperAdmin") || User.IsInRole("Journalist") || User.IsInRole("ANB-UMCH"))
        {
            <li class="nav-item dropdown">
                <a id="dropdownSubMenu1" href="#" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" class="nav-link dropdown-toggle">Информация</a>
                <ul aria-labelledby="dropdownSubMenu1" class="dropdown-menu border-0 shadow">
                    <li><a class="dropdown-item" asp-controller="Articles" asp-action="Create">Добавить новость</a></li>
                    <li><a class="dropdown-item" asp-controller="" asp-action="">Добавить меню в столовой</a></li>
                    <li><a class="dropdown-item" asp-controller="Home" asp-action="Create">Загрузить расписание</a></li>
                    <li><a class="dropdown-item" asp-controller="Birthdays" asp-action="Index">Дни Рождения</a></li>
                    <li><a class="dropdown-item" asp-controller="Home" asp-action="CreateElectionArticle">Добавить информацию о Выборах 2025</a></li>
                </ul>
            </li>
        }
        <li class="nav-item d-none d-sm-inline-block">
            <a asp-controller="Home" asp-action="GetSchedule" class="nav-link" target="_blank">Расписание</a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <a asp-controller="Home" asp-action="IndexElection" class="nav-link text-success">Выборы 2025</a>
        </li>
    </ul>
    <ul class="navbar-nav ml-auto">
        <li class="nav-item">
            <a asp-controller="Home" asp-action="Index" class="nav-link text-right">@ViewBag.FullName</a>
        </li>
    </ul>
</nav>

<div style="padding:7%">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h2>Дни рождения</h2>
                </div>
            </div>
        </div>
    </section>
    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <div id="example1_wrapper" class="dataTables_wrapper dt-bootstrap4">
                                <div class="row">
                                    <div class="col-sm-12">
                                        <a class="btn btn-primary mb-3" asp-controller="Birthdays" asp-action="Create">Добавить День Рождения</a>
                                        <table class="table table-bordered table-sm compact dataTable hover" role="grid" id="Table">
                                            <thead class="thead-dark">
                                                <tr role="row">
                                                    <th class="sorting_asc">#</th>
                                                    <th class="sorting_asc">Ф.И.О</th>
                                                    <th class="sorting_asc">Дата</th>
                                                    <th class="sorting_asc"></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in Model)
                                                {
                                                    <tr role="row" class="odd bg-white">
                                                        <td tabindex="0" class="sorting_1">@i</td>
                                                        <td tabindex="0" class="sorting_1">@item.Title</td>
                                                        <td tabindex="0" class="sorting_1">@item.Date.ToShortDateString()</td>
                                                        <td tabindex="0" class="sorting_1">
                                                            <div class="container">
                                                                <a title="Удалить" class="btn btn-danger btn-sm" asp-controller="Birthdays" asp-action="Delete" asp-route-id="@item.BirthdayID"><i class="fa fa-remove"></i></a>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                    i++;
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<script src="~/js/data_table.js"></script>