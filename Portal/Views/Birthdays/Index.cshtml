@model IEnumerable<Portal.Models.Birthday.Birthday>
@{
    ViewData["Title"] = "Дни Рождения";
    int i = 1;
}

<nav class="main-header navbar navbar-expand navbar-white navbar-light">
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
        </li>
    </ul>
</nav>

<div style="padding:7%">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h2>Дни рождения</h2>
                </div>
            </div>
        </div>
    </section>
    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <div id="example1_wrapper" class="dataTables_wrapper dt-bootstrap4">
                                <div class="row">
                                    <div class="col-sm-12">
                                        <a class="btn btn-primary mb-3" asp-controller="Birthdays" asp-action="Create">Добавить День Рождения</a>
                                        <table class="table table-bordered table-sm compact dataTable hover" role="grid" id="Birth">
                                            <thead class="thead-dark">
                                                <tr role="row">
                                                    <th class="sorting_asc">#</th>
                                                    <th class="sorting_asc">Ф.И.О</th>
                                                    <th class="sorting_asc">Дата</th>
                                                    <th class="sorting_asc"></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in Model)
                                                {
                                                    <tr role="row" class="odd bg-white">
                                                        <td tabindex="0" class="sorting_1">@i</td>
                                                        <td tabindex="0" class="sorting_1">@item.Title</td>
                                                        <td tabindex="0" class="sorting_1">@item.Date.ToShortDateString()</td>
                                                        <td tabindex="0" class="sorting_1">
                                                            <div class="container">
                                                                <a title="Удалить" class="btn btn-danger btn-sm" asp-controller="Birthdays" asp-action="Delete" asp-route-id="@item.BirthdayID"><i class="fa fa-remove"></i></a>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                    i++;
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
<script src="~/js/data_table.js"></script>