@model Portal.Models.Birthday.Birthday

@{
    ViewData["Title"] = "Удалить ДР";
}

<nav class="main-header navbar navbar-expand navbar-white navbar-light">
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
        </li>
    </ul>
    <ul class="navbar-nav ml-auto">
        <li class="nav-item">
            <a asp-controller="Home" asp-action="Index" class="nav-link text-right">@ViewBag.FullName</a>
        </li>
    </ul>
</nav>

<div style="padding: 15%">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                </div>
            </div>
        </div>
    </section>
    <section class="content mt-3">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <div id="example1_wrapper" class="dataTables_wrapper dt-bootstrap4">
                                <div class="row">
                                    <div class="col-sm-12">
                                        <div class="bg-danger text-center text-white">
                                            <h4>Вы уверены что желаете удалить?</h4>
                                            <p>Удаление занятия повлечет за собой удаление всех связанных с ним данных.</p>
                                        </div>
                                        <dl class="row">
                                            <dt class="col-sm-2">
                                                Ф.И.О
                                            </dt>
                                            <dd class="col-sm-10">
                                                @Html.DisplayFor(model => model.Title)
                                            </dd>
                                            <dt class="col-sm-2">
                                                Дата
                                            </dt>
                                            <dd class="col-sm-10">
                                                @Html.DisplayFor(model => model.Date)
                                            </dd>
                                        </dl>
                                        <form asp-action="Delete">
                                            <input type="hidden" asp-for="BirthdayID" />
                                            <input type="submit" value="Удалить" class="btn btn-danger" />
                                            <a class="btn btn-primary" asp-controller="Birthdays" asp-action="Index">Назад</a>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>