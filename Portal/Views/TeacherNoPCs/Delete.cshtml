@model Portal.Models.TeacherNoPC

@{
    ViewData["Title"] = "Удалить преподавателя";
}

@await Html.PartialAsync("_NavMenuJournal")

<div style="padding:10%">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                </div>
            </div>
        </div>
    </section>
    <section class="content mt-3">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <div id="example1_wrapper" class="dataTables_wrapper dt-bootstrap4">
                                <div class="row">
                                    <div class="col-sm-12">
                                        <div class="bg-danger text-center text-white">
                                            <h4>Вы уверены что желаете удалить преподавателя?</h4>
                                        </div>
                                        <dl class="row">
                                            <dt class="col-sm-2">
                                                Преподаватель
                                            </dt>
                                            <dd class="col-sm-10">
                                                @Model.LastName @Model.Name @Model.Surname
                                            </dd>
                                        </dl>
                                        <form asp-action="Delete">
                                            <input type="hidden" asp-for="TeacherNoPCID" />
                                            <input type="submit" value="Удалить" class="btn btn-danger" />
                                            <a class="btn btn-primary" asp-controller="TeacherNoPCs" asp-action="Index">Назад</a>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
