@model Portal.Models.Subject

@{
    ViewData["Title"] = "Создать предмет";
}

@await Html.PartialAsync("_NavMenuJournal")

<div style="padding:10%">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3>Создать предмет</h3>
                </div>
            </div>
        </div>
    </section>
    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <div id="example1_wrapper" class="dataTables_wrapper dt-bootstrap4">
                                <div class="row">
                                    <div class="col-sm-12">
                                        <form asp-action="CreateSubject">
                                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                                            <div class="form-group">
                                                <label asp-for="DepartmentID" class="control-label">Кафедра</label>
                                                <select asp-for="DepartmentID" class="form-control" asp-items="ViewBag.DepartmentID"></select>
                                            </div>
                                            <div class="form-group">
                                                <label asp-for="Name" class="control-label">Предмет</label>
                                                <input asp-for="Name" class="form-control" />
                                                <span asp-validation-for="Name" class="text-danger"></span>
                                            </div>
                                            <div class="form-group">
                                                <label asp-for="ShortName" class="control-label">Краткое наименование</label>
                                                <input asp-for="ShortName" class="form-control" />
                                                <span asp-validation-for="ShortName" class="text-danger"></span>
                                            </div>
                                            <div class="form-group border p-2">
                                                @foreach (var s in ViewBag.Specialitys)
                                                {
                                                    <input type="checkbox" value="@s.SpecialityID" name="specialitysId" />
                                                    <label class="control-label">@s.Name</label>
                                                    <br />
                                                }
                                            </div>
                                            <div class="form-group">
                                                <input type="submit" value="Создать" class="btn btn-success" />
                                                <a class="btn btn-primary" asp-controller="Departments" asp-action="ChooseDepartment">Назад</a>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
