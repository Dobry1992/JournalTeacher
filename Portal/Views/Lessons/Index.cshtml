@model IEnumerable<Portal.Models.Lesson>

@{
    ViewData["Title"] = "Занятия";
    int i = 1;
}

@await Html.PartialAsync("_NavMenuJournal")

<div style="padding:7%">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h2>Список занятий</h2>
                </div>
            </div>
        </div>
    </section>
    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <form asp-action="Index" method="get" class="mb-3">
                                <div class="form-row">
                                    <div class="form-group col-md-2">
                                        <label for="date_1">Начальная дата:</label>
                                        <input class="form-control" type="datetime-local" name="date_1" />
                                    </div>
                                    <div class="form-group col-md-2">
                                        <label for="date_2">Конечная дата:</label>
                                        <input class="form-control" type="datetime-local" name="date_2" />
                                    </div>
                                    <div class="form-group col-md-2">
                                        <label for="groupId">Группа:</label>
                                        <select name="groupId" class="form-control">
                                            <option value="0">Выберите группу</option>
                                            @foreach (var group in ViewBag.Groups)
                                            {
                                                <option value="@group.GroupID">@group.Name</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="form-group col-md-3">
                                        <label for="subjectId">Предмет:</label>
                                        <select name="subjectId" class="form-control">
                                            <option value="0">Выберите предмет</option>
                                            @foreach (var subject in ViewBag.Subjects)
                                            {
                                                <option value="@subject.SubjectID">@subject.Name</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="form-group col-md-3">
                                        <label for="teacher">Преподаватель:</label>
                                        <select name="teacher" class="form-control">
                                            <option value="">Выберите преподавателя</option>
                                            @foreach (var teacher in ViewBag.Teachers)
                                            {
                                                <option value="@teacher">@teacher</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <input type="submit" value="Поиск" class="btn btn-primary form-control" />
                            </form>
                            <div id="example1_wrapper" class="dataTables_wrapper dt-bootstrap4">
                                <div class="row">
                                    <div class="col-sm-12">
                                        <table class="table table-bordered table-sm compact dataTable hover" role="grid" id="LessonsTable">
                                            <thead class="thead-dark">
                                                <tr role="row">
                                                    <th class="sorting_asc">#</th>
                                                    <th class="sorting">Тип занятия</th>
                                                    <th class="sorting">Предмет</th>
                                                    <th class="sorting">Тема</th>
                                                    <th class="sorting">Номер темы</th>
                                                    <th class="sorting">Группа</th>
                                                    <th class="sorting">Подпись преподавателя</th>
                                                    <th class="sorting">Комментарий</th>
                                                    <th class="sorting">Дата</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in Model)
                                                {
                                                    <tr role="row" class="odd bg-white">
                                                        <td tabindex="0" class="sorting_1">@i</td>
                                                        <td tabindex="0" class="sorting_1">@item.TypeOfExercise.Name</td>
                                                        <td tabindex="0" class="sorting_1">@item.Theme.Subject.Name</td>
                                                        <td tabindex="0" class="sorting_1">@item.Theme.Name</td>
                                                        <td tabindex="0" class="sorting_1">@item.Theme.ShortName</td>
                                                        <td tabindex="0" class="sorting_1"><a class="text-decoration-none text-success" asp-controller="Groups" asp-action="DetailsGroup" asp-route-id="@item.Group.GroupID">@item.Group.Name</a></td>
                                                        <td tabindex="0" class="sorting_1">@item.Signature</td>
                                                        <td tabindex="0" class="sorting_1">@item.Comment</td>
                                                        <td tabindex="0" class="sorting_1">@item.Date.ToShortDateString()</td>
                                                    </tr>
                                                    i++;
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<script src="~/js/lessons.js"></script>
