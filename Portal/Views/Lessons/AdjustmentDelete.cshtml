@model Portal.Models.Lesson

@{
    ViewData["Title"] = "Удалить занятие";
}

@await Html.PartialAsync("_NavMenuJournal")

<div style="padding: 15%">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                </div>
            </div>
        </div>
    </section>
    <section class="content mt-3">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <div id="example1_wrapper" class="dataTables_wrapper dt-bootstrap4">
                                <div class="row">
                                    <div class="col-sm-12">
                                        <div class="bg-danger text-center text-white">
                                            <h4>Вы уверены что желаете удалить?</h4>
                                            <p>Удаление занятия повлечет за собой удаление всех связанных с ним данных.</p>
                                        </div>
                                        <dl class="row">
                                            <dt class="col-sm-2">
                                                Предмет
                                            </dt>
                                            <dd class="col-sm-10">
                                                @Html.DisplayFor(model => model.Theme.Subject.Name)
                                            </dd>
                                            <dt class="col-sm-2">
                                                Тема
                                            </dt>
                                            <dd class="col-sm-10">
                                                @Html.DisplayFor(model => model.Theme.Name)
                                            </dd>
                                            <dt class="col-sm-2">
                                                Дата
                                            </dt>
                                            <dd class="col-sm-10">
                                                @Model.Date.ToShortDateString()
                                            </dd>
                                            <dt class="col-sm-2">
                                                Группа
                                            </dt>
                                            <dd class="col-sm-10">
                                                @Model.Group.Name
                                            </dd>
                                        </dl>
                                        <form asp-action="AdjustmentDelete">
                                            <input type="hidden" asp-for="LessonID" />
                                            <input type="hidden" asp-for="GroupID" />
                                            <input type="hidden" asp-for="SubjectID" />
                                            <input type="submit" value="Удалить" class="btn btn-danger" />
                                            <a class="btn btn-primary" asp-controller="Journals" asp-action="AdjustedJournal" asp-route-GroupID="@ViewBag.GroupID" asp-route-SubjectID="@ViewBag.SubjectID">Назад</a>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
