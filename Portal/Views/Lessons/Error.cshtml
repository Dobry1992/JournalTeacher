@model Portal.Models.Lesson

@{
    ViewData["Title"] = "Ошибка!";
}

@await Html.PartialAsync("_NavMenuJournal")

<div style="padding:15%">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                </div>
            </div>
        </div>
    </section>
    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body bg-gray">
                            <div id="example1_wrapper" class="dataTables_wrapper dt-bootstrap4">
                                <div class="row">
                                    <div class="col-sm-12">
                                        <div class="text-center p-2">
                                            <h2 class="bg-danger">ОШИБКА СОЗДАНИЯ КОНТРОЛЬНОГО ЗАНЯТИЯ!</h2>
                                            <p class="font-italic" style="font-size:larger">
                                                При создании контрольного занятия произошла ошибка!<br />
                                                Чтобы провести контрольное занятие необходимо иметь
                                                от двух и более текущих отметок, которые еще не учитывались при предыдущих контрольных занятиях.
                                            </p>
                                            <a class="btn btn-primary text-white" asp-route-SubjectID="@ViewBag.SubjectID" asp-route-GroupID="@ViewBag.GroupID" asp-controller="Journals" asp-action="Journal">Назад</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
