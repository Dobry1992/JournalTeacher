@model Portal.Models.Lesson

@{
    ViewData["Title"] = "Создать курсовой проект/курсовую работу";
    var returnUrl = ViewBag.ReturnUrl as string;
}

@await Html.PartialAsync("_NavMenuJournal")

<div style="padding:7%">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h2>Создать курсовой проект/курсовую работу</h2>
                </div>
            </div>
        </div>
    </section>
    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <div id="example1_wrapper" class="dataTables_wrapper dt-bootstrap4">
                                <div class="row">
                                    <div class="col-sm-12">
                                        <form asp-action="CreateK" method="post">
                                            @Html.AntiForgeryToken()
                                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                                            
                                            <input type="hidden" asp-for="GroupID" />
                                            <input type="hidden" asp-for="ThemeID" value="@ViewBag.ThemeID" />
                                            <input type="hidden" name="returnUrl" value="@returnUrl" />

                                            <div class="form-group">
                                                <label asp-for="SubjectID" class="control-label">Предмет:</label>
                                                <select asp-for="SubjectID" class="form-control">
                                                    <option value="">-- Выберите предмет --</option>
                                                    @if (ViewBag.SubjectsList != null)
                                                    {
                                                        foreach (var subject in ViewBag.SubjectsList)
                                                        {
                                                            if (ViewBag.SelectedSubjectID != null && subject.SubjectID == ViewBag.SelectedSubjectID)
                                                            {
                                                                <option value="@subject.SubjectID" selected="selected">@subject.Name</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="@subject.SubjectID">@subject.Name</option>
                                                            }
                                                        }
                                                    }
                                                </select>
                                                <span asp-validation-for="SubjectID" class="text-danger"></span>
                                            </div>

                                            <div class="form-group">
                                                <label asp-for="TypeOfExerciseID" class="control-label">Тип занятия:</label>
                                                <select asp-for="TypeOfExerciseID" class="form-control" asp-items="@(ViewData["TypeOfExerciseID"] as SelectList)">
                                                    <option value="">-- Выберите тип --</option>
                                                </select>
                                                <span asp-validation-for="TypeOfExerciseID" class="text-danger"></span>
                                            </div>

                                            @if (User.IsInRole("ICDA-writer"))
                                            {
                                                <div class="form-group">
                                                    <label asp-for="Signature" class="control-label">Преподаватель:</label>
                                                    <select asp-for="Signature" class="form-control">
                                                        <option value="@ViewBag.UserName">@ViewBag.UserName</option>
                                                        @if (ViewBag.Teachers != null)
                                                        {
                                                            foreach (var teacher in ViewBag.Teachers)
                                                            {
                                                                <option value="@teacher.FamilyName @teacher.Name @teacher.Surname">@teacher.FamilyName @teacher.Name @teacher.Surname</option>
                                                            }
                                                        }
                                                    </select>
                                                    <span asp-validation-for="Signature" class="text-danger"></span>
                                                </div>
                                            }
                                            else if (User.IsInRole("K-8Writer"))
                                            {
                                                <div class="form-group">
                                                    <label asp-for="Signature" class="control-label">Преподаватель:</label>
                                                    <select asp-for="Signature" class="form-control">
                                                        <option value="@ViewBag.UserName">@ViewBag.UserName</option>
                                                        @if (ViewBag.TeachersNoPC != null)
                                                        {
                                                            foreach (var teacher in ViewBag.TeachersNoPC)
                                                            {
                                                                <option value="@teacher.LastName @teacher.Name @teacher.Surname">@teacher.LastName @teacher.Name @teacher.Surname</option>
                                                            }
                                                        }
                                                    </select>
                                                    <span asp-validation-for="Signature" class="text-danger"></span>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="form-group">
                                                    <label asp-for="Signature" class="control-label">Преподаватель:</label>
                                                    <input asp-for="Signature" class="form-control" value="@ViewBag.UserName" readonly />
                                                    <span asp-validation-for="Signature" class="text-danger"></span>
                                                </div>
                                            }

                                            <div class="form-group">
                                                <label asp-for="Comment" class="control-label">Комментарий преподавателя:</label>
                                                <textarea asp-for="Comment" class="form-control" rows="3"></textarea>
                                                <span asp-validation-for="Comment" class="text-danger"></span>
                                            </div>

                                            <div class="form-group">
                                                <label asp-for="Date" class="control-label">Дата:</label>
                                                <input asp-for="Date" class="form-control" type="date" />
                                                <span asp-validation-for="Date" class="text-danger"></span>
                                            </div>

                                            <div class="form-group">
                                                <button type="submit" class="btn btn-primary">Создать</button>
                                                
                                               
                                                    <a class="btn btn-outline-primary" 
                                                       asp-controller="Journals" 
                                                       asp-action="Statement" 
                                                       asp-route-GroupID="@ViewBag.GroupID">Назад</a>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}