@model Portal.Models.Department

@{
    ViewData["Title"] = "Информация о кафедре";
    int i = 1;
    List<Subject> subjects = new();
    foreach (Subject subject in Model.Subjects)
    {
        subjects.Add(subject);
    }
    var OrderSubjects = subjects.OrderBy(s => s.Arch)
        .ThenBy(s => s.Name);
}

@await Html.PartialAsync("_NavMenuJournal")

<div>
    <section class="content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h1 class="mb-3">Список предметов</h1>
                </div>
            </div>
        </div>
    </section>
    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <div id="example1_wrapper" class="dataTables_wrapper dt-bootstrap4">
                                <div class="row">
                                    <div class="col-sm-12 table-wrap">
                                        <h4 class="mb-3">Кафедра - @Model.Name</h4>
                                        <table id="Table" class="table table-bordered dataTable dtr-inline" role="grid">
                                            <thead class="thead-dark">
                                                <tr role="row">
                                                    <th class="sorting_asc">#</th>
                                                    <th class="sorting_asc">Предмет</th>
                                                    <th class="sorting_asc">Действие</th>

                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (Subject subject in OrderSubjects)
                                                {
                                                    @if (subject.Arch == false)
                                                    {
                                                        <tr role="row" class="odd bg-white">
                                                            <td tabindex="0" class="sorting_1">@i</td>
                                                            <td tabindex="0" class="sorting_1">@Html.DisplayFor(modelItem => subject.Name)</td>
                                                            <td tabindex="0" class="sorting_1">
                                                                <div class="container">
                                                                    <a title="Редактировать" class="btn btn-warning" asp-controller="Subjects" asp-action="Edit" asp-route-id="@subject.SubjectID"><i class="fa fa-file-edit"></i></a>
                                                                    <a title="Информация" class="btn btn-info" asp-controller="Subjects" asp-action="Details" asp-route-id="@subject.SubjectID"><i class="fa fa-info"></i></a>
                                                                    <a title="Добавить в архив" class="btn btn-secondary" asp-controller="Subjects" asp-action="Archive" asp-route-id="@subject.SubjectID"><i class="fa fa-file-archive"></i></a>
                                                                    <a title="Удалить" class="btn btn-danger" asp-controller="Subjects" asp-action="Delete" asp-route-id="@subject.SubjectID"><i class="fa fa-remove"></i></a>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }
                                                    else
                                                    {
                                                        <tr role="row" class="odd bg-gray">
                                                            <td tabindex="0" class="sorting_1">@i</td>
                                                            <td tabindex="0" class="sorting_1">@Html.DisplayFor(modelItem => subject.Name)</td>
                                                            <td tabindex="0" class="sorting_1">
                                                                <div class="container">
                                                                    <a title="Редактировать" class="btn btn-warning" asp-controller="Subjects" asp-action="Edit" asp-route-id="@subject.SubjectID"><i class="fa fa-file-edit"></i></a>
                                                                    <a title="Информация" class="btn btn-info" asp-controller="Subjects" asp-action="Details" asp-route-id="@subject.SubjectID"><i class="fa fa-info"></i></a>
                                                                    <a title="Разархивировать" class="btn btn-success" asp-controller="Subjects" asp-action="Archive" asp-route-id="@subject.SubjectID"><i class="fa fa-file-archive"></i></a>
                                                                    <a title="Удалить" class="btn btn-danger" asp-controller="Subjects" asp-action="Delete" asp-route-id="@subject.SubjectID"><i class="fa fa-remove"></i></a>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }

                                                    i++;
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@section scripts{
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
