@using Portal.ViewModel
@model List<GroupSummaryStatementViewModel>

@{
    ViewData["Title"] = "Сводная ведомость";
    var groupName = ViewBag.GroupName as string ?? "Без названия";

    // Единый список колонок: (SubjectID, SubjectName, TypeID, TypeName, Date.Date)
    var allColumns = (Model ?? new List<GroupSummaryStatementViewModel>())
        .SelectMany(s => s.Marks ?? Enumerable.Empty<MarkGroupSummaryStatement>())
        .Select(m => new
        {
            SubjectID = m.SubjectID ?? -1, // чтобы Distinct работал даже при null
            SubjectName = m.SubjectName ?? "",
            ShortSubjectName = m.ShortSubjectName,
            TypeID = m.TypeID,
            TypeName = m.TypeName ?? "",
            ShortTypeName = m.ShortTypeName,
            Date = m.Date.Date
        })
        .Distinct()
        .OrderBy(c => c.SubjectName)
        .ThenBy(c => c.TypeName)
        .ThenBy(c => c.Date)
        .ToList();

    var hasData = Model != null && Model.Any();
    int n = 1;
}

@await Html.PartialAsync("_NavMenuJournal")

<div>
    <section class="content-header">
        <div class="container-fluid">
            <div class="row">
            </div>
        </div>
    </section>
</div>


@if (!hasData)
{
    <div class="alert alert-info mb-0">Нет данных для отображения.</div>
}
else
{
    <div class="mb-2 h5 text-center">Ведомость группы: @groupName</div>

    <div class="table-scroll">
        <table class="table table-bordered table-sm marks-table">
            <thead>
                <tr>
                    <th class="sticky-col index-col align-middle text-center">№</th>
                    <th class="sticky-col name-col align-middle">Ф.И.О.</th>
                    @foreach (var col in allColumns)
                    {
                        <th class="rotate-col align-middle text-center">
                            <div class="rotate-content">
                                <strong>@col.ShortTypeName</strong><br />
                                @col.ShortSubjectName<br />
                                @col.Date.ToString("dd.MM.yyyy")
                            </div>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td class="sticky-col index-col text-center align-middle">@n</td>
                        <td class="sticky-col name-col align-middle">@s.StudentFullName</td>

                        @foreach (var col in allColumns)
                        {
                            // Если на одну «ячейку» у студента несколько оценок — выведем через запятую
                            var cellMarks = (s.Marks ?? Enumerable.Empty<MarkGroupSummaryStatement>())
                            .Where(m => (m.SubjectID ?? -1) == col.SubjectID
                            && m.TypeID == col.TypeID
                            && m.Date.Date == col.Date)
                            .Select(m => m.Value)
                            .ToList();

                            <td class="mark-col text-center align-middle">
                                @(cellMarks.Any() ? string.Join(", ", cellMarks) : "–")
                            </td>
                        }
                    </tr>
                    n++;
                }
            </tbody>
        </table>
    </div>
}