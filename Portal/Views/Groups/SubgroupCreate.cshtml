@model Portal.ViewModel.SubgroupCreateViewModel

@{
    ViewData["Title"] = "Создание подгруппы";
}

@await Html.PartialAsync("_NavMenuJournal")

<div>
    <section class="content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-lg-6 col-md-8 col-sm-10 mx-auto">

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fa fa-check-circle"></i> @TempData["SuccessMessage"]
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                    }

                    <div class="card shadow-sm">
                        <div class="card-header bg-primary text-white text-center">
                            <h4 class="mb-0">
                                <i class="fa fa-users"></i> Создание подгруппы
                            </h4>
                            <small>Группа: "@Model.GroupName" | Предмет: "@Model.SubjectName"</small>
                        </div>
                        <div class="card-body">
                            <form asp-action="SubgroupCreate" method="post">
                                <input type="hidden" asp-for="GroupID" />
                                <input type="hidden" asp-for="SubjectID" />
                                <div asp-validation-summary="All" class="text-danger"></div>

                                <!-- Название подгруппы -->
                                <div class="form-group mb-3">
                                    <label asp-for="SubgroupName" class="font-weight-bold">
                                        <i class="fa fa-tag"></i> @Html.DisplayNameFor(m => m.SubgroupName):
                                    </label>
                                    <input asp-for="SubgroupName" class="form-control"
                                           placeholder="Введите название подгруппы" autofocus />
                                    <span asp-validation-for="SubgroupName" class="text-danger"></span>
                                </div>

                                <!-- Выбор студентов -->
                                <div class="form-group mb-3">
                                    <label class="font-weight-bold">
                                        <i class="fa fa-user-graduate"></i> Свободные студенты:
                                    </label>
                                    <small class="text-muted d-block mb-2">
                                        (Студенты, которые еще не добавлены в подгруппы по этому предмету)
                                    </small>
                                    <span asp-validation-for="SelectedStudentIDs" class="text-danger d-block"></span>

                                    <div class="border rounded p-2 bg-light" style="max-height: 350px; overflow-y: auto;">
                                        @if (Model.AvailableStudents != null && Model.AvailableStudents.Any())
                                        {
                                            <table class="table table-sm table-hover mb-0">
                                                <thead class="thead-light">
                                                    <tr>
                                                        <th style="width: 40px;"></th>
                                                        <th style="width: 40px;">№</th>
                                                        <th>ФИО</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @{ int index = 1; }
                                                    @foreach (var student in Model.AvailableStudents)
                                                    {
                                                        <tr>
                                                            <td>
                                                                <input type="checkbox"
                                                                       name="SelectedStudentIDs"
                                                                       value="@student.StudentID"
                                                                       id="student_@student.StudentID"
                                                                       @(Model.SelectedStudentIDs.Contains(student.StudentID) ? "checked" : "") />
                                                            </td>
                                                            <td>@(index++)</td>
                                                            <td>
                                                                <label for="student_@student.StudentID" class="mb-0" style="cursor: pointer;">
                                                                    @student.Surname @student.Name @student.LastName
                                                                </label>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        }
                                        else
                                        {
                                            <div class="alert alert-info mb-0 py-2">
                                                <i class="fa fa-info-circle"></i> Все студенты уже распределены по подгруппам
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- Кнопки -->
                                <div class="form-group d-flex justify-content-between mt-4">
                                    <a asp-action="SubgroupSelectSubject" asp-route-id="@Model.GroupID" class="btn btn-secondary">
                                        <i class="fa fa-arrow-left"></i> Назад
                                    </a>
                                    <button type="submit" class="btn btn-success">
                                        <i class="fa fa-save"></i> Создать
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}