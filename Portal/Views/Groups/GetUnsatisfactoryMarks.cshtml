@using Portal.ViewModel
@model List<UnsatisfactoryViewModel>

@{
    ViewData["Title"] = "Неудовлетворительные отметки";
    int i = 1;
}

@await Html.PartialAsync("_NavMenuJournal")

<div>
    <section class="content-header">
        <div class="container-fluid">
            <div class="row">
            </div>
        </div>
    </section>
</div>

<section class="content">
    <div class="container-fluid">
        <form asp-action="GetUnsatisfactoryMarks" method="get" class="d-flex align-items-end gap-3 mb-3 flex-wrap">
            <input type="hidden" name="id" value="@ViewBag.id" />
            <div class="mr-2">
                <label for="date_1" class="form-label">Начальная дата:</label>
                <input class="form-control" type="date" name="date_1" id="date_1" />
            </div>
            <div class="mr-2">
                <label for="date_2" class="form-label">Конечная дата:</label>
                <input class="form-control" type="date" name="date_2" id="date_2" />
            </div>
            <div class="mr-2">
                <button type="submit" class="btn btn-primary">Поиск</button>
            </div>
        </form>
    </div>
</section>

<div class="container-fluid mt-3">
    <div class="card">
        <div class="card-body">
            <h6 class="mb-3 text-center bg-gray-light headGroup p-2 rounded shadow">Ведомость неудовлетворительных отметок @ViewBag.GroupName</h6>
            <div class="table-responsive" id="sd">
                <table class="table table-bordered table-sm compact" id="marks">
                    <thead class="thead-dark">
                        <tr role="row">
                            <th class="text-center align-middle p-1 fix tableRowSticky title-row">#</th>
                            <th class="text-center align-middle p-1 fix tableRowSticky title-row">Ф.И.О.</th>
                            <th class="text-center align-middle p-1 tableRowSticky">Дисциплина</th>
                            <th class="text-center align-middle p-1 tableRowSticky">Тип занятия</th>
                            <th class="text-center align-middle p-1 tableRowSticky">Комментарий</th>
                            <th class="text-center align-middle p-1 tableRowSticky">Неудовлетворительная отметка</th>
                            <th class="text-center align-middle p-1 tableRowSticky">Дата получения</th>
                            <th class="text-center align-middle p-1 tableRowSticky">Исправленная отметка</th>
                            <th class="text-center align-middle p-1 tableRowSticky">Дата исправления</th>
                            <th class="text-center align-middle p-1 tableRowSticky"></th>
                        </tr>
                    </thead>
                    <tbody class="bg-white compact">
                        @foreach (var mark in Model)
                        {
                            <tr>
                                <td class="text-center align-middle bg-light p-1 fix">@i</td>
                                <td class="text-center align-middle bg-light p-1 fix" style="white-space:nowrap">@mark.StudentFullName</td>
                                <td class="text-center align-middle p-1">@mark.SubjectFullName</td>
                                <td class="text-center align-middle p-1">@mark.TypeName</td>
                                <td class="text-center align-middle p-1">@mark.Comment</td>
                                <td class="text-center align-middle p-1">@mark.UnsatisfactoryMark</td>
                                <td class="text-center align-middle p-1">@mark.UsatisfactoryDate.ToShortDateString()</td>
                                <td class="text-center align-middle p-1">@(mark.CorrectedValue ?? "-")</td>
                                <td class="text-center align-middle p-1">@(mark.CorrectedDate?.ToShortDateString() ?? "-")</td>
                                <td class="text-center align-middle p-1"><a asp-action="AdjustedJournal" asp-controller="Journals" asp-route-GroupID="@mark.GroupID" asp-route-SubjectID="@mark.SubjectID" class="btn btn-sm btn-primary">журнал</a></td>
                            </tr>
                            i++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(function () {
            $('.btn-tooltip').tooltip();
        });
        document.addEventListener("DOMContentLoaded", function () {
            const div = document.getElementById('sd');
            const savedScroll = localStorage.getItem('scrollLeft') || 0;
            const savedScrollTop = localStorage.getItem('scrollTop') || 0;

            div.scrollLeft = savedScroll;
            div.scrollTop = savedScrollTop;

            div.addEventListener('scroll', () => {
                localStorage.setItem('scrollLeft', div.scrollLeft);
                localStorage.setItem('scrollTop', div.scrollTop);
            });
        });
    </script>
}