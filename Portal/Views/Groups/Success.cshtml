@{
    ViewData["Title"] = "Создать потоковую лекцию";
}

@await Html.PartialAsync("_NavMenuJournal")

<div style="padding:10%">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6 m-auto">
                </div>
            </div>
        </div>
    </section>
    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-6 m-auto">
                    <div class="alert alert-success card-body" role="alert">
                        <h4 class="alert-heading">Успех!</h4>
                        <p>Потоковая лекция успешно создана. Вы можете дальше продолжить работу в журнале.</p>
                        <hr>
                        <a class="btn btn-success custom-control text-decoration-none" asp-controller="Home" asp-action="Index">Вернуться к журналу отметок</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
