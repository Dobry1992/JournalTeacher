@model Portal.Models.Group

@{
    ViewData["Title"] = "Редактирование группы";
}

@await Html.PartialAsync("_NavMenuJournal")

<div style="padding:7%">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3>Редактировать группу</h3>
                </div>
            </div>
        </div>
    </section>
    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <div id="example1_wrapper" class="dataTables_wrapper dt-bootstrap4">
                                <div class="row">
                                    <div class="col-sm-12">
                                        <form asp-action="Edit">
                                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                                            <input type="hidden" asp-for="GroupID" />
                                            <input type="hidden" asp-for="InstituteID" />
                                            <input type="hidden" asp-for="SpecialityID" />
                                            <div class="form-group">
                                                <label asp-for="Name" class="control-label">Группа</label>
                                                <input asp-for="Name" class="form-control" />
                                                <span asp-validation-for="Name" class="text-danger"></span>
                                            </div>
                                            <div class="form-group">
                                                <label asp-for="DateEnter" class="control-label">Дата начала обучения</label>
                                                <input type="date" asp-for="DateEnter" class="form-control" />
                                                <span asp-validation-for="DateEnter" class="text-danger"></span>
                                            </div>
                                            <div class="form-group">
                                                <label asp-for="DateExit" class="control-label">Дата окончания обучения</label>
                                                <input type="date" asp-for="DateExit" class="form-control" />
                                                <span asp-validation-for="DateExit" class="text-danger"></span>
                                            </div>
                                            <div class="form-group">
                                                <input type="submit" value="Сохранить" class="btn btn-success" />
                                                <a class="btn btn-primary" asp-controller="Groups" asp-action="Index">Назад</a>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
