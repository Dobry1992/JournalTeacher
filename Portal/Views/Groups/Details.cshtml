@model Portal.Models.Group

@{
    ViewData["Title"] = "Детали группы";
    int i = 1;
    List<Student> students = new();
    foreach (Student student in Model.Students)
    {
        students.Add(student);
    }
    var studentsOrder = students.OrderByDescending(s => s.Status).ThenBy(s => s.LastName);
    var subgroups = ViewBag.Subgroups as List<Portal.ViewModel.SubgroupViewModel>
                    ?? new List<Portal.ViewModel.SubgroupViewModel>();
}

@await Html.PartialAsync("_NavMenuJournal")

<div>
    <section class="content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid">

            <!-- Заголовок группы на всю ширину -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <h4 class="mb-2">
                                Группа - @Model.Name<br>
                                Cпециальность - @Model.Speciality.Name<br>
                                Даты обучения: @Model.DateEnter.ToShortDateString() - @Model.DateExit.ToShortDateString()
                            </h4>
                            <a title="Создать подгруппу"
                               class="btn btn-success btn-sm mb-0"
                               asp-controller="Groups"
                               asp-action="SubgroupSelectSubject"
                               asp-route-id="@Model.GroupID">
                                <i class="fa fa-users"></i> Создать подгруппу
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Две колонки: слева студенты, справа подгруппы -->
            <div class="row">

                <!-- ЛЕВАЯ КОЛОНКА: СТУДЕНТЫ -->
                <div class="col-lg-6">
                    <div class="card">
                        <div class="card-header bg-secondary text-white">
                            <h5 class="mb-0">
                                <i class="fa fa-user-graduate"></i> Курсанты/слушатели
                                <span class="badge badge-light ml-2">@studentsOrder.Count()</span>
                            </h5>
                        </div>
                        <div class="card-body">
                            <div id="example1_wrapper" class="dataTables_wrapper dt-bootstrap4">
                                <div class="row">
                                    <div class="col-sm-12 table-wrap">
                                        <table id="Table" class="mt-0 table table-bordered dataTable compact dtr-inline" role="grid">
                                            <thead class="thead-dark">
                                                <tr role="row">
                                                    <th class="sorting_asc">#</th>
                                                    <th class="sorting_asc">Ф.И.О.</th>
                                                    <th class="sorting">Действие</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in studentsOrder)
                                                {
                                                    @if (item.Status == true)
                                                    {
                                                        <tr role="row" class="odd bg-white">
                                                            <td tabindex="0" class="sorting_1">@i</td>
                                                            <td tabindex="0" class="sorting_1">@item.LastName @item.Name @item.Surname</td>
                                                            <td tabindex="0" class="sorting_1">
                                                                <div class="container">
                                                                    <a title="Редактировать" class="btn btn-warning btn-sm" asp-controller="Students" asp-action="Edit" asp-route-id="@item.StudentID"><i class="fa fa-file-edit"></i></a>
                                                                    <a title="Информация" class="btn btn-info btn-sm" asp-controller="Students" asp-action="Details" asp-route-id="@item.StudentID"><i class="fa fa-info"></i></a>
                                                                    <a title="Отчислить" class="btn btn-secondary btn-sm" asp-controller="Students" asp-action="SetStatus" asp-route-id="@item.StudentID"><i class="fa fa-lock"></i></a>
                                                                    <a title="Удалить" class="btn btn-danger btn-sm" asp-controller="Students" asp-action="Delete" asp-route-id="@item.StudentID"><i class="fa fa-remove"></i></a>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }
                                                    else
                                                    {
                                                        <tr role="row" class="odd bg-gray">
                                                            <td tabindex="0" class="sorting_1">@i</td>
                                                            <td tabindex="0" class="sorting_1">@item.LastName @item.Name @item.Surname</td>
                                                            <td tabindex="0" class="sorting_1">
                                                                <div class="container">
                                                                    <a title="Редактировать" class="btn btn-warning btn-sm" asp-controller="Students" asp-action="Edit" asp-route-id="@item.StudentID"><i class="fa fa-file-edit"></i></a>
                                                                    <a title="Информация" class="btn btn-info btn-sm" asp-controller="Students" asp-action="Details" asp-route-id="@item.StudentID"><i class="fa fa-info"></i></a>
                                                                    <a title="Восстановить" class="btn btn-success btn-sm" asp-controller="Students" asp-action="SetStatus" asp-route-id="@item.StudentID"><i class="fa fa-lock-open"></i></a>
                                                                    <a title="Удалить" class="btn btn-danger btn-sm" asp-controller="Students" asp-action="Delete" asp-route-id="@item.StudentID"><i class="fa fa-remove"></i></a>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }
                                                    i++;
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ПРАВАЯ КОЛОНКА: ПОДГРУППЫ -->
<div class="col-lg-6">
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="fa fa-users"></i> Подгруппы
                @if (subgroups.Any())
                {
                    <span class="badge badge-light ml-2">@subgroups.Count</span>
                }
            </h5>
        </div>
        <div class="card-body">
            @if (!subgroups.Any())
            {
                <div class="alert alert-info mb-0 text-center">
                    <i class="fa fa-info-circle"></i> Для данной группы подгруппы ещё не созданы.
                </div>
            }
            else
            {
                <div id="subgroupsAccordion">
                    @for (int j = 0; j < subgroups.Count; j++)
                    {
                        var sg = subgroups[j];
                        var collapseId = $"collapse_{j}";
                        <div class="card mb-2">
                            <div class="card-header" id="heading_@j">
                                <div class="d-flex justify-content-between align-items-center">

                                    <button type="button"
                                            class="btn btn-link text-left text-decoration-none p-0 flex-grow-1 subgroup-toggle"
                                            data-target="#@collapseId"
                                            aria-expanded="false"
                                            aria-controls="@collapseId">
                                        <i class="fa fa-caret-right"></i>
                                        <strong>@sg.Name</strong>
                                        <span class="badge badge-info ml-2">@sg.SubjectName</span>
                                        <span class="badge badge-secondary ml-1">@sg.Students.Count студ.</span>
                                    </button>

                                    <div class="ml-2 text-nowrap">
                                        <a asp-action="EditSubgroup"
                                           asp-route-groupId="@Model.GroupID"
                                           asp-route-subjectId="@sg.SubjectID"
                                           asp-route-name="@sg.Name"
                                           class="btn btn-warning btn-sm" title="Редактировать">
                                            <i class="fa fa-edit"></i>
                                        </a>
                                        <a asp-action="DeleteSubgroup"
                                           asp-route-groupId="@Model.GroupID"
                                           asp-route-subjectId="@sg.SubjectID"
                                           asp-route-name="@sg.Name"
                                           class="btn btn-danger btn-sm" title="Удалить">
                                            <i class="fa fa-trash"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>

                            <div id="@collapseId" class="collapse" aria-labelledby="heading_@j">
                                <div class="card-body p-0">
                                    <table class="table table-sm table-bordered mb-0">
                                        <thead class="thead-light">
                                            <tr>
                                                <th style="width:60px;">#</th>
                                                <th>Ф.И.О.</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{ int n = 1; }
                                            @foreach (var st in sg.Students)
                                            {
                                                <tr>
                                                    <td>@n</td>
                                                    <td>@st.LastName @st.Name @st.Surname</td>
                                                </tr>
                                                n++;
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

            </div>
            <!-- /.row -->

        </div>
    </section>
</div>

@section scripts{
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }

    <script>
        $(document).on('click', '.subgroup-toggle', function (e) {
            e.preventDefault();
            e.stopPropagation();

            var $btn = $(this);
            var targetSel = $btn.attr('data-target');
            var $target = $(targetSel);
            if (!$target.length) return;

            var isOpen = $target.hasClass('show');
            if (isOpen) {
                $target.removeClass('show');
                $btn.attr('aria-expanded', 'false');
                $btn.find('i.fa').removeClass('fa-caret-down').addClass('fa-caret-right');
            } else {
                $target.addClass('show');
                $btn.attr('aria-expanded', 'true');
                $btn.find('i.fa').removeClass('fa-caret-right').addClass('fa-caret-down');
            }
        });
    </script>
}