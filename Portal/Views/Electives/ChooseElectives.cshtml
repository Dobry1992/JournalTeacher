@model IEnumerable<Portal.Models.Elective.Elective>

@{
    ViewData["Title"] = "Факультативы";
    string[] colors = { "primary", "success", "danger", "info", "warning", "gradient-navy", "gradient-olive", "gradient-lime", "gradient-teal", "gradient-yellow", "indigo" };
    int i = 0;
}

@await Html.PartialAsync("_NavMenuJournal")

<section class="content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
            </div>
        </div>
    </div>
</section>
@foreach (var department in ViewBag.Departments)
{
    if (i == colors.Length) i = 0;
    <section class="content">
        <div class="container-fluid">
            <h4 class="mb-3 text-center bg-@colors[i] headGroup p-2 rounded">@department.Name</h4>
            <div class="d-flex flex-row flex-wrap">
                @foreach (var elective in Model)
                {
                    if (elective.DepartmentID == department.DepartmentID)
                    {
                        <a asp-controller="Journals" asp-action="ElectiveJournal" asp-route-electiveID="@elective.ElectiveID" class="groups d-block p-3 mr-3 mb-3 text-decoration-none rounded shadow-lg bg-@colors[i]">
                            <p class="text-center">
                                <span class="text-xl">@Html.DisplayFor(modelItem => elective.Name)</span><br />
                            </p>
                        </a>
                    }
                }
            </div>
        </div>
    </section>
    <hr>
    i++;
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}