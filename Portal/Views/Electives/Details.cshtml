@model Portal.Models.Elective.Elective

@{
    ViewData["Title"] = "Факультатив";
}

@await Html.PartialAsync("_NavMenuJournal")

<div style="padding:10%">
    <section class="content-header">
        <div class="container-fluid">
        </div>
    </section>
    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <h6 class="mb-3 text-center bg-warning headGroup p-2 rounded">Факультатив: @Model.Name</h6>
                            <div id="example1_wrapper" class="dataTables_wrapper dt-bootstrap4">
                                <div class="row">
                                    <div class="col-sm-12 table-wrap">
                                        <a asp-controller="ElectiveThemes" asp-action="Create" asp-route-id="@Model.ElectiveID" asp-route-departmentID ="@Model.DepartmentID" class="btn btn-primary mb-3">Добавить тему</a>
                                        <table id="Table" class="table table-striped dataTable dtr-inline compact" role="grid">
                                            <thead class="thead-light">
                                                <tr role="row">
                                                    <th class="sorting">Номер, вид занятия</th>
                                                    <th class="sorting">Номер темы</th>
                                                    <th class="sorting">Действие</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in Model.Themes.OrderBy(t => t.ShortName))
                                                {
                                                    @if (item.Name != "Контрольное занятие")
                                                    {
                                                        <tr role="row" class="odd bg-light">
                                                            <td tabindex="0" class="sorting_1">@Html.DisplayFor(modelItem => item.Name)</td>
                                                            <td tabindex="0" class="sorting_1">@item.ShortName</td>
                                                            <td tabindex="0" class="sorting_1">
                                                                <div class="container">
                                                                    <a title="Редактировать" class="btn btn-warning" asp-controller="ElectiveThemes" asp-action="Edit" asp-route-id="@item.ElectiveThemeID" asp-route-electiveID="@Model.ElectiveID"><i class="fa fa-file-edit"></i></a>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@section scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}