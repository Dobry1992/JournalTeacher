@using Portal.ViewModel
@model JournalViewModel

@{
    ViewData["Title"] = "Журнал";
    int i = 1;
    int j = 1;
}

@await Html.PartialAsync("_NavMenuJournal")

<div>
    <section class="content-header">
        <div class="container-fluid">
            <div class="row">
            </div>
        </div>
    </section>
</div>

@if (ViewBag.CountFlag == 0)
{
    <div style="padding:15%">
        <section class="content">
            <div class="container-fluid">
                <div class="card">
                    <div class="card-body bg-warning" style="opacity:0.8">
                        <div class="text-center p-2">
                            <h2>Журнал не сформирован!</h2>
                            <p class="font-italic" style="font-size:larger">
                                Журнал оценок для выбранных Вами группы и предмета не сформирован.<br>
                                Для его формирования обратитесь в УМЧ.
                            </p>
                            <a class="btn btn-danger text-white"
                               asp-route-SubjectID="@ViewBag.SubjectID"
                               asp-route-GroupID="@ViewBag.GroupID"
                               asp-controller="Journals"
                               asp-action="Create">
                                Сформировать журнал
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
}
else
{
    <section class="content">
        <div class="container-fluid">
            <div class="card">
                <div class="card-body">
                    <h6 class="mb-3 text-center bg-warning headGroup p-2 rounded">
                        Группа: @Model.Group.Name,<br />
                        предмет: @Model.Subject.Name
                    </h6>

                    <div class="btn-group mr-2 mb-3 border rounded">
                        <a class="btn btn-light p-2"
                           asp-route-GroupID="@Model.Group.GroupID"
                           asp-route-SubjectID="@Model.Subject.SubjectID"
                           asp-controller="Lessons"
                           asp-action="AdjustmentCreate">Занятие</a>
                        <a class="btn btn-danger p-2"
                           asp-route-GroupID="@Model.Group.GroupID"
                           asp-route-SubjectID="@Model.Subject.SubjectID"
                           asp-controller="Lessons"
                           asp-action="AdjustmentCreateF">Экзамен/Зачёт</a>
                        <a class="btn btn-primary p-2"
                           asp-route-GroupID="@Model.Group.GroupID"
                           asp-route-SubjectID="@Model.Subject.SubjectID"
                           asp-controller="Lessons"
                           asp-action="AdjustmentCreateK">Курсовой проект</a>
                    </div>

                    <a class="btn btn-outline-warning p-2 mb-3 mr-2"
                       asp-action="Final"
                       asp-route-GroupID="@Model.Group.GroupID"
                       asp-route-SubjectID="@Model.Subject.SubjectID">
                        Итоги обучения
                    </a>

                    <a class="btn btn-outline-info p-2 mb-3 mr-2"
                       asp-action="Controls"
                       asp-route-GroupID="@Model.Group.GroupID"
                       asp-route-SubjectID="@Model.Subject.SubjectID">
                        Котрольные занятия
                    </a>

                    <div class="btn-group mr-2 mb-3 border rounded">
                        <a class="btn btn-outline-success"
                           asp-controller="Print"
                           asp-action="PrintJournal"
                           asp-route-subjectID="@Model.Subject.SubjectID"
                           asp-route-groupID="@Model.Group.GroupID">
                            Экспорт
                        </a>
                        <button type="button"
                                class="btn btn-outline-danger"
                                data-toggle="modal"
                                data-target="#modal-content">
                            Экзаменационная ведомость
                        </button>
                    </div>
                    <div class="table-wrap" id="sd">
                        <table class="table table-bordered compact table-sm control-table">
                            <thead class="thead-dark compact">
                                <tr>
                                    <th class="align-middle text-center p-1 fix">#</th>
                                    <th class="align-middle text-center p-1 fix">Ф.И.О.</th>
                                    @foreach (var lesson in Model.JournalLessons)
                                    {
                                        <th class="align-middle text-center p-0 m-0">
                                            <a class="btn btn-outline-danger text-white border-0 p-1 m-0 btn-tooltip"
                                               data-toggle="tooltip"
                                               data-placement="left"
                                               data-html="true"
                                               data-title="Подпись: @lesson.Lesson.Signature<br />@lesson.Lesson.TypeOfExercise.Name"
                                               asp-controller="Lessons"
                                               asp-action="AdjustmentDelete"
                                               asp-route-id="@lesson.Lesson.LessonID"
                                               asp-route-SubjectID="@Model.Subject.SubjectID"
                                               asp-route-GroupID="@Model.Group.GroupID">
                                                <span class="rotate-sm-90">
                                                    @lesson.Lesson.TypeOfExercise.ShortName<br />
                                                    @lesson.Lesson.Theme.ShortName<br />
                                                    @lesson.Lesson.Date.ToShortDateString()
                                                </span>
                                            </a>
                                        </th>
                                    }
                                </tr>
                            </thead>
                            <tbody class="bg-white compact">
                                @foreach (var student in Model.Students)
                                {
                                    <tr>
                                        <td class="align-middle text-center p-1 bg-light fix">@i</td>
                                        <td class="align-middle text-center p-1 bg-light fix">@student.LastName @student.Name @student.Surname</td>
                                        @foreach (var mark in Model.JournalMarks.Where(m => m.Mark.StudentID == student.StudentID))
                                        {
                                            <td class="align-middle text-center p-0 @mark.Property">
                                                <a asp-controller="Marks"
                                                   asp-action="AdjustmentEdit"
                                                   asp-route-MarkID="@mark.Mark.MarkID"
                                                   asp-route-SubjectID="@Model.Subject.SubjectID"
                                                   asp-route-GroupID="@Model.Group.GroupID"
                                                   class="btn border-0 text-center align-middle p-3 btn-tooltip"
                                                   data-toggle="tooltip"
                                                   data-placement="left"
                                                   data-html="true"
                                                   data-title="Подпись: @mark.Mark.SignatureOfTeacher<br>История:<br> @mark.Mark.HistoryOfMark"
                                                   style="width:100%;">
                                                    @mark.Mark.Value
                                                </a>
                                            </td>
                                        }
                                    </tr>
                                    i++;
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- Модальное окно -->
    <div class="modal fade" id="modal-content" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Выберите ведомость</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Закрыть">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <table class="table table-bordered compact table-sm">
                        <thead class="thead-dark">
                            <tr>
                                <th class="text-center p-1 fix">#</th>
                                <th class="text-center p-1 fix">Зачёт/экзамен</th>
                                <th class="text-center p-1 fix">Дата</th>
                                <th class="text-center p-1 fix"></th>
                            </tr>
                        </thead>
                        <tbody class="bg-white compact">
                            @foreach (var l in Model.StatementLessons)
                            {
                                <tr>
                                    <td class="text-center p-1 bg-light fix">@j</td>
                                    <td class="text-center p-1 bg-light fix">@l.TypeOfExercise.Name</td>
                                    <td class="text-center p-1 bg-light fix">@l.Date.ToShortDateString()</td>
                                    <td class="text-center p-1 bg-light fix">
                                        <a class="btn btn-warning"
                                           asp-controller="Print"
                                           asp-action="PrintStatement"
                                           asp-route-id="@l.LessonID"
                                           target="_blank"
                                           rel="noopener">Выбрать</a>
                                    </td>
                                </tr>
                                j++;
                            }
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-danger" data-dismiss="modal">Закрыть</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        $(function () {
            $('.btn-tooltip').tooltip();
        });

        window.addEventListener('DOMContentLoaded', function () {
            const div = document.querySelector('#sd');
            const scroll = localStorage.getItem('scroll') || 0;
            div.scrollLeft = scroll;
            div.addEventListener('scroll', function () {
                localStorage.setItem('scroll', div.scrollLeft);
            });
        });
    </script>
    <script src="~/js/journal.js"></script>
}
