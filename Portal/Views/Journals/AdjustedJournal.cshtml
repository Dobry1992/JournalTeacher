@using Portal.ViewModel
@model JournalViewModel


@{
    ViewData["Title"] = "Журнал";
    int i = 1;
    int j = 1;
    int k = 1;
}

@await Html.PartialAsync("_NavMenuJournal")

<div>
    <section class="content-header">
        <div class="container-fluid">
            <div class="row">
            </div>
        </div>
    </section>
</div>

@if (ViewBag.CountFlag == 0)
{
    <div class="text-center p-5">
        <div class="alert alert-warning" role="alert">
            <h4 class="alert-heading">Журнал не сформирован</h4>
            <p>Для выбранной группы и предмета журнал отсутствует.</p>
            @if (User.IsInRole("ANB-UMCH") || User.IsInRole("SuperAdmin"))
            {
                <a asp-controller="Journals" asp-action="Create"
                   asp-route-GroupID="@ViewBag.GroupID"
                   asp-route-SubjectID="@ViewBag.SubjectID"
                   class="btn btn-danger mt-3">Сформировать журнал</a>
            }
        </div>
    </div>
}
else
{
    <div class="container-fluid mt-3">
        <div class="card">
            <div class="card-body">
                <h6 class="text-center mb-4 bg-warning p-2 rounded">
                    Группа: @Model.Group.Name<br />
                    предмет: @Model.Subject.Name
                </h6>

                <div class="mb-3 d-flex flex-wrap gap-2">
                    <a class="btn btn-dark mr-2 btn-sm" asp-controller="Lessons" asp-action="AdjustmentCreate"
                       asp-route-GroupID="@Model.Group.GroupID" asp-route-SubjectID="@Model.Subject.SubjectID">
                        Занятие
                    </a>
                    <a class="btn btn-danger mr-2 btn-sm" asp-controller="Lessons" asp-action="AdjustmentCreateF"
                       asp-route-GroupID="@Model.Group.GroupID" asp-route-SubjectID="@Model.Subject.SubjectID">
                        Экзамен/Зачёт
                    </a>
                    <a class="btn btn-primary mr-2 btn-sm" asp-controller="Lessons" asp-action="AdjustmentCreateK"
                       asp-route-GroupID="@Model.Group.GroupID" asp-route-SubjectID="@Model.Subject.SubjectID">
                        Курсовой проект
                    </a>
                    <a class="btn btn-info mr-2 btn-sm"
                       asp-action="Controls"
                       asp-route-GroupID="@Model.Group.GroupID"
                       asp-route-SubjectID="@Model.Subject.SubjectID">
                        Котрольные занятия
                    </a>
                    <a class="btn btn-outline-warning mr-2 btn-sm" asp-action="Final"
                       asp-route-GroupID="@Model.Group.GroupID" asp-route-SubjectID="@Model.Subject.SubjectID">
                        Итоги обучения
                    </a>
                    <button class="btn btn-outline-success mr-2 btn-sm" data-toggle="modal" data-target="#modal-content-2">
                        Экспорт
                    </button>
                    <button class="btn btn-outline-danger mr-2 btn-sm" data-toggle="modal" data-target="#modal-content-1">
                        Экзаменационная ведомость
                    </button>

                    @if(Model.IsActive)
                    {
                        <a class="btn btn-success mr-2 btn-sm" asp-controller="CompletedSubjects" asp-action="Create"
                       asp-route-GroupID="@Model.Group.GroupID" asp-route-SubjectID="@Model.Subject.SubjectID">
                        Завершить предмет
                    </a>
                    }
                    else
                    {
                        <a class="btn btn-success mr-2 btn-sm" asp-controller="CompletedSubjects" asp-action="Delete"
                       asp-route-GroupID="@Model.Group.GroupID" asp-route-SubjectID="@Model.Subject.SubjectID">
                        Продолжить предмет
                    </a>
                    }
                    <button id="collapseToggleBtn" class="btn btn-outline-secondary ml-auto btn-sm">
                        Скрыть занятия и отметки
                    </button>
                </div>

                <div class="table-responsive" id="sd">
                    <table class="table table-bordered table-sm compact">
                        <thead class="thead-dark">
                            <tr>
                                <th class="align-middle text-center p-1 fix tableRowSticky title-row col-fixed-1">#</th>
                                <th class="align-middle text-center p-1 fix tableRowSticky title-row col-fixed-2">Ф.И.О.</th>
                                @foreach (var lesson in Model.JournalLessons)
                                {
                                    <th class="align-middle text-center p-0 tableRowSticky" id="@lesson.CollapseId">
                                        @if (lesson.Lesson.LessonID != 0)
                                        {
                                            <a class="btn btn-outline-danger text-white border-0 p-1 btn-tooltip"
                                               data-toggle="tooltip"
                                               data-placement="left"
                                               data-html="true"
                                               data-title="Подпись: @lesson.Lesson.Signature<br />@lesson.Lesson.TypeOfExercise.Name"
                                               asp-controller="Lessons"
                                               asp-action="AdjustmentDelete"
                                               asp-route-id="@lesson.Lesson.LessonID"
                                               asp-route-SubjectID="@Model.Subject.SubjectID"
                                               asp-route-GroupID="@Model.Group.GroupID">
                                                <span class="rotate-sm-90">
                                                    @lesson.Lesson.TypeOfExercise.ShortName<br />
                                                    @lesson.Lesson.Theme.ShortName<br />
                                                    @lesson.Lesson.Date.ToShortDateString()
                                                </span>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="btn btn-outline-success text-white border-0 p-1 m-0 btn-tooltip"
                                                  data-toggle="tooltip"
                                                  data-placement="left"
                                                  data-html="true"
                                                  data-title="Средняя отметка">
                                                <span class="rotate-sm-90">
                                                    СО
                                                </span>
                                            </span>
                                        }
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody class="bg-white compact">
                            @foreach (var student in Model.Students)
                            {
                                    <tr>
                                    <td class="align-middle text-center p-1 bg-light fix col-fixed-1">@i</td>
                                    <td class="align-middle text-left p-1 bg-light fix col-fixed-2">@student.LastName @student.Name @student.Surname</td>
                                    @foreach (var mark in Model.JournalMarks.Where(m => m.Mark.StudentID == student.StudentID))
                                    {
                                        if (mark.Mark.MarkID != 0)
                                        {
                                            <td class="align-middle text-center p-0 @mark.Property" id="@mark.CollapseId">
                                                <a asp-controller="Marks"
                                                   asp-action="AdjustmentEdit"
                                                   asp-route-MarkID="@mark.Mark.MarkID"
                                                   asp-route-SubjectID="@Model.Subject.SubjectID"
                                                   asp-route-GroupID="@Model.Group.GroupID"
                                                   class="btn border-0 p-2 btn-tooltip w-100"
                                                   data-toggle="tooltip"
                                                   data-placement="left"
                                                   data-html="true"
                                                   data-title="Подпись: @mark.Mark.SignatureOfTeacher<br>История:<br> @mark.Mark.HistoryOfMark"
                                                   style="width:100%;">
                                                    @mark.Mark.Value
                                                </a>
                                            </td>
                                        }
                                        else
                                        {
                                            <td class="align-middle text-center p-0 @mark.Property" id="@mark.CollapseId">
                                                <span class="btn border-0 p-2 btn-tooltip w-100"
                                                      data-toggle="tooltip"
                                                      data-placement="left"
                                                      data-html="true"
                                                      data-title="Средняя отметка"
                                                      style="width:100%;">
                                                    @mark.Mark.Value
                                                </span>
                                            </td>
                                        }
                                    }
                                </tr>
                                i++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <!-- Модальное окно 1-->
    <div class="modal fade" id="modal-content-1" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Выберите ведомость</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Закрыть">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <table class="table table-bordered compact table-sm">
                        <thead class="thead-dark">
                            <tr>
                                <th class="text-center p-1 fix">#</th>
                                <th class="text-center p-1 fix">Зачёт/экзамен</th>
                                <th class="text-center p-1 fix">Дата</th>
                                <th class="text-center p-1 fix"></th>
                            </tr>
                        </thead>
                        <tbody class="bg-white compact">
                            @foreach (var l in Model.StatementLessons)
                            {
                                <tr>
                                    <td class="text-center p-1 bg-light fix">@j</td>
                                    <td class="text-center p-1 bg-light fix">@l.TypeOfExercise.Name</td>
                                    <td class="text-center p-1 bg-light fix">@l.Date.ToShortDateString()</td>
                                    <td class="text-center p-1 bg-light fix">
                                        <a class="btn btn-warning"
                                           asp-controller="Print"
                                           asp-action="PrintStatement"
                                           asp-route-id="@l.LessonID"
                                           target="_blank"
                                           rel="noopener">Выбрать</a>
                                    </td>
                                </tr>
                                j++;
                            }
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-danger" data-dismiss="modal">Закрыть</button>
                </div>
            </div>
        </div>
    </div>
    <!-- Модальное окно 2-->
    <div class="modal fade" id="modal-content-2" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Выберите журнал</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Закрыть">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <table class="table table-bordered compact table-sm">
                        <thead class="thead-dark">
                            <tr>
                                <th class="text-center p-1 fix">#</th>
                                <th class="text-center p-1 fix">Учебный год</th>
                                <th class="text-center p-1 fix"></th>
                            </tr>
                        </thead>
                        <tbody class="bg-white compact">
                            @foreach (var l in ViewBag.AcademicYears)
                            {
                                <tr>
                                    <td class="text-center p-1 bg-light fix">@k</td>
                                    <td class="text-center p-1 bg-light fix">@l.Name</td>
                                    <td class="text-center p-1 bg-light fix">
                                        <a class="btn btn-warning btn-sm"
                                           asp-controller="Journals"
                                           asp-action="ExportToExcel"
                                           asp-route-d1="@l.StartDate?.ToString("yyyy-MM-dd")"
                                           asp-route-d2="@l.EndDate?.ToString("yyyy-MM-dd")"
                                           asp-route-SubjectID="@Model.Subject.SubjectID"
                                           asp-route-GroupID="@Model.Group.GroupID"
                                           target="_blank"
                                           rel="noopener">
                                            <i class="fas fa-file-excel"></i>
                                        </a>
                                    </td>
                                </tr>
                                k++;
                            }
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-danger" data-dismiss="modal">Закрыть</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        $(function () {
            $('.btn-tooltip').tooltip();
        });

        document.addEventListener("DOMContentLoaded", function () {
            const div = document.getElementById('sd');
            const savedScrollLeft = localStorage.getItem('scrollLeft') || 0;
            const savedScrollTop = localStorage.getItem('scrollTop') || 0;

            div.scrollLeft = savedScrollLeft;
            div.scrollTop = savedScrollTop;

            div.addEventListener('scroll', () => {
                localStorage.setItem('scrollLeft', div.scrollLeft);
                localStorage.setItem('scrollTop', div.scrollTop);
            });

            const btn = document.getElementById("collapseToggleBtn");
            // Determine table and header columns; hide entire columns whose header has collapse id
            const table = document.querySelector('#sd table');
            const headers = table ? Array.from(table.querySelectorAll('thead tr:first-child th')) : [];
            // use DOM cellIndex to account for colspans and ensure correct column mapping
            const collapseIndices = headers
                .map(th => (th.id && th.id.startsWith('collapse')) ? th.cellIndex : -1)
                .filter(i => i >= 0)
                .sort((a,b)=>a-b);

            // Determine which CO headers belong to previous contiguous collapse ranges.
            // Strategy: compress collapseIndices into contiguous ranges [start..end]. For each range, if there is a header
            // immediately to the right at cellIndex = end+1 and its text is CO/СО, mark that CO to hide. This avoids hiding
            // COs that are not directly associated with a collapsed group.
            const hideIndicesSet = new Set(collapseIndices);
            if (collapseIndices.length) {
                // build ranges
                const ranges = [];
                let rangeStart = collapseIndices[0];
                let prev = collapseIndices[0];
                for (let i = 1; i < collapseIndices.length; i++) {
                    const cur = collapseIndices[i];
                    if (cur === prev + 1) {
                        prev = cur; // extend range
                    } else {
                        ranges.push([rangeStart, prev]);
                        rangeStart = cur; prev = cur;
                    }
                }
                ranges.push([rangeStart, prev]);

                // for each range, check header at end+1
                ranges.forEach(r => {
                    const end = r[1];
                    const candidateIndex = end + 1;
                    const th = headers.find(h => h.cellIndex === candidateIndex);
                    if (th) {
                        const text = (th.innerText||th.textContent||'').trim().toUpperCase();
                        if (text === 'CO' || text === 'СО') {
                            hideIndicesSet.add(candidateIndex);
                        }
                    }
                });
            }
            const hideIndicesArr = Array.from(hideIndicesSet).sort((a,b)=>a-b);
            let hidden = localStorage.getItem("collapseHidden") === "true";

            function setColumnDisplay(idx, display) {
                if (!table) return;
                Array.from(table.querySelectorAll('tr')).forEach(tr => {
                    const cell = tr.children[idx];
                    if (cell) cell.style.display = display;
                });
            }

            function toggleCells() {
                if (!table) return;
                // hide entire columns for collapse indices and their matching CO indices
                const targets = typeof hideIndicesArr !== 'undefined' ? hideIndicesArr : hideIndices;
                targets.forEach(idx => setColumnDisplay(idx, hidden ? 'none' : ''));
                // also hide any individual cell that has collapse id (defensive)
                Array.from(table.querySelectorAll('[id^="collapse"]')).forEach(c => { c.style.display = hidden ? 'none' : ''; });
                btn.textContent = hidden
                    ? "Показать занятия и отметки"
                    : "Скрыть занятия и отметки";
            }

            toggleCells();

            btn.addEventListener("click", () => {
                hidden = !hidden;
                localStorage.setItem("collapseHidden", hidden);
                toggleCells();
            });
        });
    </script>
}
