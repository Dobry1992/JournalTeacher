@using Portal.ViewModel
@model JournalViewModel

@{
    ViewData["Title"] = "Журнал";
    int i = 1;
    int j = 1;
}

@await Html.PartialAsync("_NavMenuJournal")

<div>
    <section class="content-header">
        <div class="container-fluid">
            <div class="row">
            </div>
        </div>
    </section>
</div>

@if (ViewBag.CountFlag == 0)
{
    <div class="text-center p-5">
        <div class="alert alert-warning" role="alert">
            <h4 class="alert-heading">Журнал не сформирован</h4>
            <p>Для выбранной группы и предмета журнал отсутствует.</p>
            @if (User.IsInRole("ANB-UMCH") || User.IsInRole("SuperAdmin"))
            {
                <a asp-controller="Journals" asp-action="Create"
                   asp-route-GroupID="@ViewBag.GroupID"
                   asp-route-SubjectID="@ViewBag.SubjectID"
                   class="btn btn-danger mt-3">Сформировать журнал</a>
            }
        </div>
    </div>
}
else if (User.IsInRole("SuperAdmin") || User.IsInRole("ANB-UMCH") || User.IsInRole("ANB-HEAD") || User.IsInRole(Model.Department.Role))
{
    <div class="container-fluid mt-3">
        <div class="card">
            <div class="card-body">
                <h6 class="text-center mb-4 bg-warning p-2 rounded">
                    Группа: @Model.Group.Name<br />
                    предмет: @Model.Subject.Name
                </h6>

                <div class="mb-3 d-flex flex-wrap gap-2">
                    <a class="btn btn-dark mr-2 btn-sm" asp-controller="Lessons" asp-action="Create"
                       asp-route-GroupID="@Model.Group.GroupID" asp-route-SubjectID="@Model.Subject.SubjectID">
                        Занятие
                    </a>
                    <a class="btn btn-danger mr-2 btn-sm" asp-controller="Lessons" asp-action="CreateF"
                       asp-route-GroupID="@Model.Group.GroupID" asp-route-SubjectID="@Model.Subject.SubjectID">
                        Экзамен/Зачёт
                    </a>
                    <a class="btn btn-primary mr-2 btn-sm" asp-controller="Lessons" asp-action="CreateK"
                       asp-route-GroupID="@Model.Group.GroupID" asp-route-SubjectID="@Model.Subject.SubjectID">
                        Курсовой проект
                    </a>
                    <a class="btn btn-outline-warning mr-2 btn-sm" asp-action="Final"
                       asp-route-GroupID="@Model.Group.GroupID" asp-route-SubjectID="@Model.Subject.SubjectID">
                        Итоги обучения
                    </a>
                    <button class="btn btn-outline-danger mr-2 btn-sm" data-toggle="modal" data-target="#modal-content">
                        Экзаменационная ведомость
                    </button>
                    <button id="collapseToggleBtn" class="btn btn-outline-secondary ml-auto btn-sm">
                        Скрыть занятия и отметки
                    </button>
                </div>

                <div class="table-responsive" id="sd">
                    <style>
                        /* Fixed first two columns: number and full name */
                        :root { --col1-width: 50px; --col2-width: 220px; }
                        .table-responsive { position: relative; }
                        .table { border-collapse: separate; }
                        .table thead th.tableRowSticky { position: sticky; top: 0; z-index: 5; }
                        .table th.col-fixed-1, .table td.col-fixed-1 {
                            position: sticky;
                            left: 0;
                            z-index: 4;
                            background: #313538;
                            box-sizing: border-box;
                        }
                        .table th.col-fixed-2, .table td.col-fixed-2 {
                            position: sticky;
                            /* account for table cell borders to avoid visual gap */
                            left: calc(var(--col1-width) + 1px);
                            z-index: 4;
                            background: #313538;
                            box-sizing: border-box;
                            /* add subtle shadow to hide seam when scrolling */
                            box-shadow: 2px 0 4px rgba(0,0,0,0.05);
                        }
                        /* Avoid double borders between fixed columns */
                        .table th.col-fixed-1, .table td.col-fixed-1 { border-right: 0; }
                        .table th.col-fixed-2, .table td.col-fixed-2 { border-left: 0; }
                        .table th.col-fixed-1 { width: var(--col1-width); min-width: var(--col1-width); }
                        .table th.col-fixed-2 { min-width: var(--col2-width); width: var(--col2-width); }
                        /* Ensure header cells overlap body cells when sticky */
                        .table thead th.col-fixed-1, .table thead th.col-fixed-2 { top: 0; z-index: 6; }
                    </style>
                    <table class="table table-bordered table-sm compact">
                        <thead class="thead-dark">
                            <tr>
                                <th class="text-center align-middle p-1 fix tableRowSticky title-row col-fixed-1">#</th>
                                <th class="text-center align-middle p-1 fix tableRowSticky title-row col-fixed-2">Ф.И.О.</th>
                                @foreach (var lesson in Model.JournalLessons)
                                {
                                    <th class="text-center align-middle p-0 tableRowSticky" id="@lesson.CollapseId">
                                        @if (lesson.IsEdit)
                                        {
                                            <a class="btn btn-outline-danger border-0 p-1 text-white btn-tooltip"
                                               asp-controller="@lesson.Controller" asp-action="@lesson.Action"
                                               asp-route-id="@lesson.Lesson.LessonID"
                                               asp-route-GroupID="@Model.Group.GroupID"
                                               asp-route-SubjectID="@Model.Subject.SubjectID"
                                               data-toggle="tooltip"
                                               data-html="true"
                                               title="Подпись: @lesson.Lesson.Signature<br>@lesson.Lesson.TypeOfExercise.Name">
                                                <span class="rotate-sm-90">
                                                    @lesson.Lesson.TypeOfExercise.ShortName<br />
                                                    @lesson.Lesson.Theme.ShortName<br />
                                                    @lesson.Lesson.Date.ToShortDateString()
                                                </span>
                                            </a>
                                        }
                                        else
                                        {
                                            if (lesson.Lesson.LessonID != 0)
                                            {
                                                <span class="btn btn-outline-danger border-0 p-1 text-white btn-tooltip"
                                                      data-toggle="tooltip"
                                                      data-html="true"
                                                      title="Подпись: @lesson.Lesson.Signature<br>@lesson.Lesson.TypeOfExercise.Name">
                                                    <span class="rotate-sm-90">
                                                        @lesson.Lesson.TypeOfExercise.ShortName<br />
                                                        @lesson.Lesson.Theme.ShortName<br />
                                                        @lesson.Lesson.Date.ToShortDateString()
                                                    </span>
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="btn btn-outline-success border-0 p-1 text-white btn-tooltip"
                                                      data-toggle="tooltip"
                                                      data-html="true"
                                                      title="Средняя отметка">
                                                    <span class="rotate-sm-90">
                                                        СО
                                                    </span>
                                                </span>
                                            }
                                        }
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody class="bg-white compact">
                            @foreach (var student in Model.Students)
                            {
                                <tr>
                                    <td class="text-center align-middle bg-light p-1 fix col-fixed-1">@i</td>
                                    <td class="text-center align-middle bg-light p-1 fix col-fixed-2">@student.LastName @student.Name @student.Surname</td>
                                    @foreach (var mark in Model.JournalMarks.Where(m => m.Mark.StudentID == student.StudentID))
                                    {
                                        if (mark.IsEdit)
                                        {
                                            <td class="text-center align-middle p-0 @mark.Property" id="@mark.CollapseId">
                                                <a class="btn border-0 p-2 btn-tooltip w-100"
                                                   asp-controller="@mark.Controller" asp-action="@mark.Action"
                                                   asp-route-MarkID="@mark.Mark.MarkID"
                                                   asp-route-SubjectID="@Model.Subject.SubjectID"
                                                   asp-route-GroupID="@Model.Group.GroupID"
                                                   data-toggle="tooltip"
                                                   data-html="true"
                                                   title="Подпись: @mark.Mark.SignatureOfTeacher<br>История:<br>@mark.Mark.HistoryOfMark">
                                                    @mark.Mark.Value
                                                </a>
                                            </td>
                                        }
                                        else
                                        {
                                            if (mark.Mark.MarkID != 0)
                                            {
                                                <td class="text-center align-middle p-0 @mark.Property" id="@mark.CollapseId">
                                                    <span class="btn border-0 p-2 btn-tooltip w-100"
                                                          data-toggle="tooltip"
                                                          data-html="true"
                                                          title="Подпись: @mark.Mark.SignatureOfTeacher<br>История:<br>@mark.Mark.HistoryOfMark">
                                                        @mark.Mark.Value
                                                    </span>
                                                </td>
                                            }
                                            else
                                            {
                                                <td class="text-center align-middle p-0 @mark.Property" id="@mark.CollapseId">
                                                    <span class="btn border-0 p-2 btn-tooltip w-100"
                                                          data-toggle="tooltip"
                                                          data-html="true"
                                                          title="Средняя отметка">
                                                        @mark.Mark.Value
                                                    </span>
                                                </td>
                                            }
                                        }
                                    }
                                </tr>
                                i++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Модальное окно -->
    <div class="modal fade" id="modal-content" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-md">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Экзаменационная ведомость</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Закрыть">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body p-2">
                    <table class="table table-bordered table-sm compact">
                        <thead class="thead-light">
                            <tr>
                                <th class="text-center p-1">#</th>
                                <th class="text-center p-1">Тип</th>
                                <th class="text-center p-1">Дата</th>
                                <th class="text-center p-1">Действие</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var l in Model.StatementLessons)
                            {
                                <tr>
                                    <td class="text-center p-1">@j</td>
                                    <td class="text-center p-1">@l.TypeOfExercise.Name</td>
                                    <td class="text-center p-1">@l.Date.ToShortDateString()</td>
                                    <td class="text-center p-1">
                                        <a class="btn btn-warning btn-sm"
                                           asp-controller="Print" asp-action="PrintStatement"
                                           asp-route-id="@l.LessonID"
                                           target="_blank" rel="noopener">
                                            Выбрать
                                        </a>
                                    </td>
                                </tr>
                                j++;
                            }
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Закрыть</button>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="container p-5 text-center">
        <div class="card border-danger">
            <div class="row no-gutters">
                <div class="col-md-4">
                    <img src="~/images/rejected.jpg" class="img-fluid" />
                </div>
                <div class="col-md-8 p-4">
                    <h3 class="text-danger">Отказ в доступе</h3>
                    <p>У Вас нет доступа к журналу данной группы и предмета.</p>
                    <small class="text-muted">@DateTime.Now.ToLongTimeString()</small>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        $(function () {
            $('.btn-tooltip').tooltip();
        });

        document.addEventListener("DOMContentLoaded", function () {
            const div = document.getElementById('sd');
            const savedScroll = localStorage.getItem('scrollLeft') || 0;
            const savedScrollTop = localStorage.getItem('scrollTop') || 0;

            div.scrollLeft = savedScroll;
            div.scrollTop = savedScrollTop;

            div.addEventListener('scroll', () => {
                localStorage.setItem('scrollLeft', div.scrollLeft);
                localStorage.setItem('scrollTop', div.scrollTop);
            });

            const btn = document.getElementById("collapseToggleBtn");
            const cells = document.querySelectorAll("th[id^='collapse'], td[id^='collapse']");
            let hidden = localStorage.getItem("collapseHidden") === "true";

            function toggleCells() {
                cells.forEach(el => el.style.display = hidden ? "none" : "");
                btn.textContent = hidden
                    ? "Показать занятия и отметки"
                    : "Скрыть занятия и отметки";
            }

            toggleCells();

            btn.addEventListener("click", () => {
                hidden = !hidden;
                localStorage.setItem("collapseHidden", hidden);
                toggleCells();
            });
        });
    </script>
}
