@model Portal.Models.Journal

@{
    ViewData["Title"] = "Сформировать журнал";
}

@await Html.PartialAsync("_NavMenuJournal")

<div style="padding:10%">
    <section class="content-header">
        <div class="container-fluid">
            <div class="">
                <h3 class="text-left">Сформировать журнал</h3>
            </div>
        </div>
    </section>
    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <div id="example1_wrapper" class="dataTables_wrapper dt-bootstrap4">
                                <div class="row">
                                    <div class="col-sm-12 table-wrap">
                                        <form asp-action="Create">
                                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                                            <div class="form-group">
                                                <label asp-for="GroupID" class="control-label">Группа</label>
                                                <select asp-for="GroupID" class="form-control" asp-items="ViewBag.GroupID"></select>
                                            </div>
                                            <div class="form-group">
                                                <label asp-for="SubjectID" class="control-label">Предмет</label>
                                                <select asp-for="SubjectID" class="form-control" asp-items="ViewBag.SubjectID"></select>
                                            </div>
                                            <div class="form-group">
                                                <label asp-for="Comment" class="control-label">Комментарий</label>
                                                <textarea asp-for="Comment" class="form-control"></textarea>
                                                <span asp-validation-for="Comment" class="text-danger"></span>
                                            </div>
                                            <div class="form-group">
                                                <input type="submit" value="Сформировать" class="btn btn-success" />
                                                <a class="btn btn-primary" asp-action="Index">Назад</a>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
