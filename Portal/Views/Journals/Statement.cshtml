@model IEnumerable<Portal.Models.StatementLesson>

@{
    ViewData["Title"] = "Итоговые отметки";
    int i = 1;

    // Отметки привязаны к занятиям (StatementLessonID ставится при создании занятия) -
    // словарь: (занятие, курсант) -> отметка, чтобы ячейки стояли строго под своими колонками
    var allMarks = (IEnumerable<Portal.Models.StatementMark>)ViewBag.Marks;
    var marksByLesson = allMarks
        .Where(m => m.StatementLessonID != 0)
        .GroupBy(m => new { m.StatementLessonID, m.StudentID })
        .ToDictionary(g => (g.Key.StatementLessonID, g.Key.StudentID), g => g.First());

    int typeDR = ViewBag.typeDR;
    int typeDP = ViewBag.typeDP;
    int typeMR = ViewBag.typeMR;
    int typePP = ViewBag.typePP;
    int typeUP = ViewBag.typeUP;
    int typeS = ViewBag.typeS;
    int typeGE = ViewBag.typeGE;
}

@await Html.PartialAsync("_NavMenuJournal")

@if (User.IsInRole("SuperAdmin") || User.IsInRole("ANB-UMCH") || User.IsInRole(ViewBag.Institute.Role))
{
    <div class="container-fluid mt-3">
        <div class="card">
            <div class="card-body">
                <h6 class="text-center mb-4 bg-warning p-2 rounded">
                    Ведомость итоговых отметок<br />
                    Группа: @ViewBag.Group.Name
                </h6>

                <div class="mb-3 d-flex flex-wrap gap-2">
                    <a class="btn btn-success btn-sm" asp-route-GroupID="@ViewBag.GroupID"
                       asp-controller="StatementLessons" asp-action="Create">
                        Добавить отметку
                    </a>
                </div>

                <div class="table-responsive" id="sd">
                    <table class="table table-bordered table-sm compact">
                        <thead class="thead-dark">
                            <tr role="row">
                                <th class="text-center align-middle p-1 fix tableRowSticky title-row col-fixed-1">#</th>
                                <th class="text-left align-middle p-1 fix tableRowSticky title-row col-fixed-2">Ф.И.О.</th>
                                @foreach (var lesson in Model)
                                {
                                    <th class="text-center align-middle p-0 tableRowSticky">
                                        <a class="btn btn-outline-danger border-0 p-1 text-white btn-tooltip"
                                           asp-controller="StatementLessons" asp-action="Delete"
                                           asp-route-id="@lesson.StatementLessonID"
                                           asp-route-GroupID="@ViewBag.GroupID"
                                           data-toggle="tooltip"
                                           data-html="true"
                                           title="Подпись: @lesson.Signature<br>@lesson.TypeOfExercise.Name<br>@lesson.Date.ToShortDateString()">
                                            <span class="rotate-sm-90">
                                                @lesson.TypeOfExercise.ShortName<br />
                                                @lesson.Date.ToShortDateString()
                                            </span>
                                        </a>
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody class="bg-white compact">
                            @foreach (var student in ViewBag.Students)
                            {
                                <tr>
                                    <td class="text-center align-middle bg-light p-1 fix col-fixed-1">@i</td>
                                    <td class="text-left align-middle bg-light p-1 fix col-fixed-2" data-student-id="@student.StudentID">@student.LastName @student.Name @student.Surname</td>
                                    @foreach (var lesson in Model)
                                    {
                                        marksByLesson.TryGetValue((lesson.StatementLessonID, (int)student.StudentID), out var mark);
                                        if (mark != null)
                                        {
                                            string markClass = "";
                                            if (mark.TypeOfExerciseID == typeDR || mark.TypeOfExerciseID == typeDP || mark.TypeOfExerciseID == typeMR)
                                                markClass = "markDR";
                                            else if (mark.TypeOfExerciseID == typePP || mark.TypeOfExerciseID == typeUP || mark.TypeOfExerciseID == typeS)
                                                markClass = "markPP";
                                            else if (mark.TypeOfExerciseID == typeGE)
                                                markClass = "markGE";
                                            <td class="text-center align-middle p-0 @markClass">
                                                <a class="btn border-0 p-2 btn-tooltip w-100 mark-menu-cell @(markClass == "markDR" ? "text-white" : "")"
                                                   asp-controller="StatementMarks" asp-action="Edit"
                                                   asp-route-id="@mark.StatementMarkID"
                                                   asp-route-GroupID="@ViewBag.GroupID"
                                                   data-menu-url="@Url.Action("EditMenu", "StatementMarks")"
                                                   @* JsonSerializer.Serialize возвращает строку - Razor закодирует кавычки для атрибута *@
                                                   data-mark="@(System.Text.Json.JsonSerializer.Serialize(new {
                                                       markID = mark.StatementMarkID,
                                                       value = mark.Value,
                                                       date = mark.Date.ToString(),
                                                       comment = mark.Comment,
                                                       signature = mark.SignatureOfTeacher,
                                                       history = mark.HistoryOfMark,
                                                       subjectID = 0,
                                                       groupID = mark.GroupID,
                                                       lessonID = mark.StatementLessonID,
                                                       typeOfExerciseID = mark.TypeOfExerciseID,
                                                       departmentID = 0,
                                                       specialityID = mark.SpecialityID,
                                                       themeID = 0,
                                                       studentID = mark.StudentID,
                                                       flagF = 0,
                                                       instituteID = mark.InstituteID,
                                                       changeCounter = 0,
                                                       subgroup = ""
                                                   }))"
                                                   data-toggle="tooltip"
                                                   data-html="true"
                                                   title="Комментарий: @mark.Comment<br>Подпись: @mark.SignatureOfTeacher<br>История:<br>@mark.HistoryOfMark">
                                                    @mark.Value
                                                </a>
                                            </td>
                                        }
                                        else
                                        {
                                            <td class="text-center align-middle p-0">
                                                <span class="btn border-0 p-2 w-100">&nbsp;</span>
                                            </td>
                                        }
                                    }
                                </tr>
                                i++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div style="padding:15%">
        <section class="content-header">
            <div class="container-fluid">
            </div>
        </section>
        <section class="content">
            <div class="card mb-3" style="max-width: 1000px;">
                <div class="row no-gutters">
                    <div class="col-md-4">
                        <img src="~/images/rejected.jpg" class="w-100 h-100">
                    </div>
                    <div class="col-md-8">
                        <div class="card-body">
                            <h3 class="card-title text-bold">Отказ в доступе.</h3>
                            <p class="card-text">Уважаемые пользователь, Вам отказано в доступе к данному журналу.</p>
                            <p class="card-text"><small class="text-muted">@DateTime.Now.ToLongDateString() @DateTime.Now.ToLongTimeString()</small></p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
}

@section Scripts {
    <script src="~/js/journal.js"></script>
    <script>
        $(function () {
            $('[data-toggle="tooltip"]').tooltip();
        });
    </script>

    @* Токен и маркер для контекстного меню быстрой выставления отметки (mark-cell-menu.js) *@
    <form style="display:none">@Html.AntiForgeryToken()</form>
    <input type="hidden" id="markMenuJournalMarker" />
    @* Список отметок совпадает с StatementMarks/Edit *@
    <script>
        window.__MARK_VALUES = [
            { value: " ", label: "Нет отметки" },
            { value: "1", label: "1" },
            { value: "2", label: "2" },
            { value: "3", label: "3" },
            { value: "4", label: "4" },
            { value: "5", label: "5" },
            { value: "6", label: "6" },
            { value: "7", label: "7" },
            { value: "8", label: "8" },
            { value: "9", label: "9" },
            { value: "10", label: "10" },
            { value: "Б", label: "Б" },
            { value: "НР", label: "НР" },
            { value: "О", label: "О" },
            { value: "КМ", label: "КМ" },
            { value: "Р", label: "Р" },
            { value: "НБ", label: "НБ" }
        ];
    </script>
    <script src="~/js/mark-cell-menu.js" asp-append-version="true"></script>
}
