@model IEnumerable<Portal.Models.Institute>
@{
    ViewData["Title"] = "Институты";
    string[] colors = { "primary", "success", "danger", "warning", "info", "gradient-navy", "gradient-olive", "gradient-lime", "gradient-teal", "gradient-yellow", "indigo" };
    int i = 0;
}

@await Html.PartialAsync("_NavMenuJournal")

<div style="padding:7%">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                </div>
            </div>
        </div>
    </section>
    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <div id="example1_wrapper">
                                <div class="row">
                                    <div class="col-sm-12">
                                        @foreach (var inst in Model)
                                        {
                                            if (i == colors.Length) i = 0;
                                            <a asp-controller="Institutes" asp-action="Details" asp-route-id="@inst.InstituteID" class="groups d-block p-4 mr-3 mb-3 text-decoration-none rounded shadow-lg bg-@colors[i]">
                                                <p class="text-center">
                                                    <span class="text-xl">@Html.DisplayFor(modelItem => inst.Name)</span>
                                                </p>
                                            </a>
                                            i++;
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
