                                                            }
                                                        }
                                                    </select>
                                                    <span asp-validation-for="SignatureOfTeacher" class="text-danger"></span>
                                                </div>
                                                <div class="form-group">
                                                    <label asp-for="Comment" class="control-label">Замечание преподавателя</label>
                                                    <textarea asp-for="Comment" class="form-control" value=""></textarea>
                                                    <span asp-validation-for="Comment" class="text-danger"></span>
                                                </div>
                                                <div class="form-group">
                                                    <input type="submit" value="Выставить отметку" class="btn btn-primary" />
